// OCL36 TEST PROCEDURE
LOAD PAYMAIN
IFF ?1?/START GOTO BEGIN
IFF ?1?/TEST GOTO TESTMODE
IFF ?1?/END RETURN
IF DATAF1-CUSTMST GOTO CUSTOK
IF DATAF1-ORDHDR GOTO ORDOK
IF DATAF1-'ARMAST,ALL' GOTO ARFOUND
IF DATAF1-'APMAST,ALL' GOTO APFOUND
IF ?F'A,CUSTMST'?/00000000 GOTO EMPTYCUST
IF ?F'A,ORDHDR'?/00000000 GOTO EMPTYORD
IF ?F'S,CUSTMST'?/00000100 GOTO BIGFILE
IF ?F'S,ORDHDR'?/00000050 GOTO MEDFILE
EVALUATE P1=?F'A,CUSTMST'?
EVALUATE P2=?F'A,ORDHDR'?
EVALUATE P3=?F'S,CUSTMST'?
EVALUATE P4=12345
IFF ACTIVE-'PROC1,PROC2' PAYROLL
IFF STATUS-'A,H,P' PROCESS
IFF REGION-'US,CA,MX' NORTHAM
IFF ?10?/92 PRINTER NAME-ETAT,LINES-50,PRIORITY-0
IFF ?10?/80 PRINTER NAME-LIST01,LINES-66,PRIORITY-5
IFF DATAF1-WORKA BLDFILE WORKA,S,BLOCKS,10,100
IFF DATAF1-WORKB BLDFILE WORKB,S,BLOCKS,20,200
TAG BEGIN
CALL INITJOB
GOTO PROCESS
TAG TESTMODE
CALL TESTDRV
GOTO ENDPROC
TAG CUSTOK
CALL CUSTCHK
TAG ORDOK
CALL ORDCHK
TAG ARFOUND
CALL ARPROC
TAG APFOUND
CALL APPROC
TAG EMPTYCUST
CALL NOCUST
TAG EMPTYORD
CALL NOORD
TAG BIGFILE
CALL BIGPROC
TAG MEDFILE
CALL MEDPROC
TAG PROCESS
CALL PROCESS1
CALL PROCESS2
CALL PROCESS3
IF ACTIVE-PROC1 RETURN
IF ACTIVE-PROC2 RETURN
TAG NORTHAM
CALL NAREPORT
TAG PAYROLL
CALL PAYCALC
TAG ENDPROC
RETURN
GO PAYMAIN
