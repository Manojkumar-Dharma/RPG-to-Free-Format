**FREE
// IAoclCvt - OCL36 to CLLE conversion logic (module of IAoclToCle).
//
// Converted in v1 (see docs/OCL-MAPPING.md for the rules and what is assumed):
//   comment lines, LOAD + RUN, FILE, LOCAL, TAG, GOTO, RETURN,
//   substitution expressions ?n?, ?USER?, ?WS?
// Everything else is written as a CL comment and reported as REVIEW.
// The converted program is collected first, because the PGM statement and
// the DCLs depend on which substitution expressions were used.

ctl-opt nomain option(*srcstmt:*nodebugio);

/copy IAcnvSrvP

dcl-c C_MAXBODY 5000;
dcl-c C_MAXITEMS 20;
dcl-c C_QUOTE '''';
dcl-c C_DFTWIDTH 80;             // line width assumed when the target width is unknown
dcl-c C_LOWER 'abcdefghijklmnopqrstuvwxyz';
dcl-c C_UPPER 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';

dcl-s g_body varchar(512) dim(C_MAXBODY);
dcl-s g_bodyCnt int(10);
dcl-s g_overflow ind;
dcl-s g_maxParm int(10);
dcl-s g_useUser ind;
dcl-s g_useWs ind;
dcl-s g_pendLoad ind;
dcl-s g_loadName varchar(60);
dcl-s g_loadLib varchar(60);
dcl-s g_loadLine int(10);
dcl-s g_loadText varchar(512);
dcl-s g_afterRun ind;
dcl-s g_width int(10);
dcl-s g_ovr varchar(300);       // FILE names overridden since the last CALL
dcl-c C_MAXSORT 200;
dcl-s g_sortMode ind;            // inside the data lines of a #GSORT step
dcl-s g_sortCond ind;            // the block contains IF/IFF/ELSE/END
dcl-s g_sortLines varchar(512) dim(C_MAXSORT);
dcl-s g_sortCnt int(10);
dcl-s g_sortNo int(10);
dcl-s g_sortFirst int(10);
dcl-s g_sortIn varchar(60) dim(8);
dcl-s g_sortOut varchar(60);
dcl-s g_sortInLib varchar(60) dim(8);
dcl-s g_sortSrcMbr varchar(60);
dcl-s g_sortSrcLib varchar(60);
dcl-s g_conditions ind;
dcl-c C_MAXTMP 600;
dcl-c C_MAXLDA 20;
dcl-s g_tmp varchar(512) dim(C_MAXTMP);
dcl-s g_tmpCnt int(10);
dcl-s g_blkP int(10) dim(C_MAXLDA);
dcl-s g_blkN int(10) dim(C_MAXLDA);
dcl-s g_blkCnt int(10);
dcl-s g_ldaP int(10) dim(C_MAXLDA);
dcl-s g_ldaN int(10) dim(C_MAXLDA);
dcl-s g_ldaCnt int(10);
dcl-s g_sortOutLib varchar(60);
dcl-s g_sortExtra varchar(200);
dcl-s g_useSql ind;
dcl-s g_parKind char(1) dim(40);   // ' ' unused, 'P' passed, 'L' local (set by EVALUATE)
dcl-s g_parLen int(10) dim(40);
dcl-s g_useDate ind;
dcl-s g_ifLast varchar(500);     // condition of the IF line before (for ELSE)
dcl-s g_ifCtx varchar(500);      // condition context when that line was an ELSE IF
dcl-s g_tmpVar int(10);
dcl-s g_isSort ind;              // the pending LOAD is #GSORT

// ------------------------------------------------------------------
dcl-proc Up;
  dcl-pi *n varchar(512);
    i_text varchar(512) const;
  end-pi;

  return %xlate(C_LOWER:C_UPPER:i_text);
end-proc;

// ------------------------------------------------------------------
dcl-proc AddBody;
  dcl-pi *n;
    i_text varchar(512) const;
  end-pi;

  if g_bodyCnt >= C_MAXBODY;
    g_overflow = *on;
    return;
  endif;
  g_bodyCnt += 1;
  g_body(g_bodyCnt) = i_text;
end-proc;

// ------------------------------------------------------------------
// Adds text as CL comment lines. The text is kept as it is (only "*/" is
// altered so it cannot end the comment). A line is split only when it would
// not fit the target width, preferably at a blank.
dcl-proc AddCommentRaw;
  dcl-pi *n;
    i_text varchar(512) const;
  end-pi;

  dcl-s l_rest varchar(512);
  dcl-s l_piece varchar(512);
  dcl-s l_max int(10);
  dcl-s l_cut int(10);
  dcl-s l_i int(10);

  l_rest = %trimr(%scanrpl('*/':'* /':i_text));
  l_max = g_width - 6;             // room for the /* and */ delimiters
  if l_max < 10;
    l_max = 10;
  endif;
  dow %len(l_rest) > 0;
    if %len(l_rest) > l_max;
      l_cut = l_max;
      for l_i = l_max downto 2;
        if %subst(l_rest:l_i:1) = ' ';
          l_cut = l_i - 1;         // break before the blank
          leave;
        endif;
      endfor;
      l_piece = %subst(l_rest:1:l_cut);
      l_rest = %subst(l_rest:l_cut + 1);
    else;
      l_piece = l_rest;
      l_rest = '';
    endif;
    AddBody('/*' + l_piece + ' */');
  enddo;
end-proc;

// ------------------------------------------------------------------
// Comment generated by the converter (text trimmed, one blank after /*).
dcl-proc AddComment;
  dcl-pi *n;
    i_text varchar(512) const;
  end-pi;

  if %len(%trim(i_text)) = 0;
    return;
  endif;
  AddCommentRaw(' ' + %trim(i_text));
end-proc;

// ------------------------------------------------------------------
// A procedure parameter ?n? (1 to 40 here; CL allows 40 parameters) is read.
// A parameter whose first use is a read is taken as passed by the caller.
dcl-proc UseParm;
  dcl-pi *n;
    i_n int(10) const;
  end-pi;

  if g_parKind(i_n) = ' ';
    g_parKind(i_n) = 'P';
  endif;
  if g_parKind(i_n) = 'P';
    g_maxParm = %max(g_maxParm:i_n);
  endif;
end-proc;

// ------------------------------------------------------------------
// Local data area text: returns the CL variable and, when i_emit is *ON,
// writes the RTVDTAARA that fills it (right before the statement using it).
dcl-proc LdaName;
  dcl-pi *n varchar(20);
    i_p int(10) const;
    i_n int(10) const;
    i_emit ind const;
  end-pi;

  dcl-s l_i int(10);
  dcl-s l_found ind inz(*off);
  dcl-s l_name varchar(20);

  l_name = '&L' + %trim(%char(i_p)) + '_' + %trim(%char(i_n));
  for l_i = 1 to g_ldaCnt;
    if g_ldaP(l_i) = i_p and g_ldaN(l_i) = i_n;
      l_found = *on;
    endif;
  endfor;
  if not l_found and g_ldaCnt < C_MAXLDA;
    g_ldaCnt += 1;
    g_ldaP(g_ldaCnt) = i_p;
    g_ldaN(g_ldaCnt) = i_n;
  endif;
  if i_emit;
    AddBody('RTVDTAARA DTAARA(*LDA (' + %trim(%char(i_p)) + ' '
            + %trim(%char(i_n)) + ')) RTNVAR(' + l_name + ')');
  endif;
  return l_name;
end-proc;

// ------------------------------------------------------------------
// Parses L'p,n' (text of a ?L'p,n'? expression). *ON when valid.
dcl-proc ParseLda;
  dcl-pi *n ind;
    i_tok varchar(60) const;
    o_p int(10);
    o_n int(10);
  end-pi;

  dcl-s l_t varchar(60);
  dcl-s l_cp int(10);
  dcl-s l_ps varchar(60);
  dcl-s l_ns varchar(60);

  l_t = Up(%trim(i_tok));
  if %len(l_t) < 6 or %subst(l_t:1:2) <> 'L''' 
     or %subst(l_t:%len(l_t):1) <> '''';
    return *off;
  endif;
  l_cp = %scan(',':l_t);
  if l_cp < 4;
    return *off;
  endif;
  l_ps = %subst(l_t:3:l_cp - 3);
  l_ns = %subst(l_t:l_cp + 1:%len(l_t) - l_cp - 1);
  if %len(l_ps) = 0 or %len(l_ps) > 4 or %len(l_ns) = 0 or %len(l_ns) > 3
     or %check('0123456789':l_ps) > 0 or %check('0123456789':l_ns) > 0;
    return *off;
  endif;
  o_p = %int(l_ps);
  o_n = %int(l_ns);
  return o_p >= 1 and o_n >= 1 and o_p + o_n <= 1025;
end-proc;

// ------------------------------------------------------------------
// Maps the text inside ?...? to a CL variable and its length. Returns ''
// when the expression is not supported. Supported: ?n? (1-40), ?USER?,
// ?WS?, ?DATE?, ?L'p,n'?.
dcl-proc ExprVar;
  dcl-pi *n varchar(20);
    i_tok varchar(60) const;
    o_len int(10);
  end-pi;

  dcl-s l_t varchar(60);
  dcl-s l_n int(10);
  dcl-s l_p int(10);

  l_t = Up(%trim(i_tok));
  o_len = 0;
  if %len(l_t) > 0 and %len(l_t) <= 2 and %check('0123456789':l_t) = 0;
    l_n = %int(l_t);
    if l_n < 1 or l_n > 40;
      return '';
    endif;
    UseParm(l_n);
    if g_parKind(l_n) = 'L';
      o_len = %max(g_parLen(l_n):1);
    else;
      o_len = 10;
    endif;
    return '&P' + %trim(%char(l_n));
  endif;
  if l_t = 'USER';
    g_useUser = *on;
    o_len = 10;
    return '&USER';
  endif;
  if l_t = 'WS';
    g_useWs = *on;
    o_len = 10;
    return '&WS';
  endif;
  if l_t = 'DATE';
    g_useDate = *on;
    o_len = 6;
    return '&DATE';
  endif;
  if ParseLda(l_t:l_p:l_n);
    o_len = l_n;
    return LdaName(l_p:l_n:*on);
  endif;
  return '';
end-proc;

// ------------------------------------------------------------------
// A name or value that may contain ?...? expressions. A single expression
// becomes its CL variable; a mixture of text and expressions is built into
// a temporary variable by CHGVAR (written before the statement).
dcl-proc OperandExpr;
  dcl-pi *n varchar(60);
    i_val varchar(200) const;
    o_ok ind;
  end-pi;

  dcl-s l_rest varchar(200);
  dcl-s l_p1 int(10);
  dcl-s l_p2 int(10);
  dcl-s l_lit varchar(200);
  dcl-s l_var varchar(20);
  dcl-s l_len int(10);
  dcl-s l_expr varchar(400) inz('');
  dcl-s l_cnt int(10) inz(0);
  dcl-s l_tmp varchar(20);

  o_ok = *on;
  if %scan('?':i_val) = 0;
    return Up(i_val);
  endif;

  l_rest = i_val;
  dow %len(l_rest) > 0;
    l_p1 = %scan('?':l_rest);
    l_var = '';
    if l_p1 = 0;
      l_lit = l_rest;
      l_rest = '';
    else;
      l_p2 = %scan('?':l_rest:l_p1 + 1);
      if l_p2 = 0;
        o_ok = *off;
        return '';
      endif;
      l_var = ExprVar(%subst(l_rest:l_p1 + 1:l_p2 - l_p1 - 1):l_len);
      if l_var = '';
        o_ok = *off;
        return '';
      endif;
      if l_p1 > 1;
        l_lit = %subst(l_rest:1:l_p1 - 1);
      else;
        l_lit = '';
      endif;
      if l_p2 >= %len(l_rest);
        l_rest = '';
      else;
        l_rest = %subst(l_rest:l_p2 + 1);
      endif;
    endif;

    if %len(l_lit) > 0;
      if l_cnt > 0;
        l_expr += ' *TCAT ';
      endif;
      l_expr += C_QUOTE + Up(l_lit) + C_QUOTE;
      l_cnt += 1;
    endif;
    if l_var <> '';
      if l_cnt > 0;
        l_expr += ' *TCAT ';
      endif;
      l_expr += l_var;
      l_cnt += 1;
    endif;
  enddo;

  if l_cnt = 1;
    return l_var;                  // the value is one expression
  endif;
  g_tmpVar += 1;
  l_tmp = '&T' + %trim(%char(g_tmpVar));
  AddBody('CHGVAR VAR(' + l_tmp + ') VALUE(' + l_expr + ')');
  return l_tmp;
end-proc;

// ------------------------------------------------------------------
// Replaces ?n?, ?USER?, ?WS?, ?DATE? and ?L'p,n'?. o_open is *ON when some other ?...?
// expression is left (it cannot be converted).
dcl-proc Subst;
  dcl-pi *n varchar(512);
    i_text varchar(512) const;
    o_open ind;
  end-pi;

  dcl-s l_in varchar(512);
  dcl-s l_out varchar(512) inz('');
  dcl-s l_p1 int(10);
  dcl-s l_p2 int(10);
  dcl-s l_tok varchar(60);
  dcl-s l_var varchar(20);
  dcl-s l_len int(10);

  o_open = *off;
  l_in = i_text;

  dow *on;
    l_p1 = %scan('?':l_in);
    if l_p1 = 0;
      l_out += l_in;
      leave;
    endif;
    l_p2 = %scan('?':l_in:l_p1 + 1);
    if l_p2 = 0;
      o_open = *on;
      l_out += l_in;
      leave;
    endif;

    if l_p1 > 1;
      l_out += %subst(l_in:1:l_p1 - 1);
    endif;
    if l_p2 = l_p1 + 1;          // "??" is not an expression
      o_open = *on;
      l_out += '??';
      if l_p2 >= %len(l_in);
        leave;
      endif;
      l_in = %subst(l_in:l_p2 + 1);
      iter;
    endif;
    l_tok = Up(%subst(l_in:l_p1 + 1:l_p2 - l_p1 - 1));

    l_var = ExprVar(l_tok:l_len);
    if l_var = '' or l_len < 0;
      o_open = *on;
      l_out += %subst(l_in:l_p1:l_p2 - l_p1 + 1);
    else;
      // CL cannot put a variable inside a word or a quoted text.
      if (%len(l_out) > 0 and %scan(%subst(l_out:%len(l_out):1):' ,()') = 0)
         or (l_p2 < %len(l_in)
         and %scan(%subst(l_in:l_p2 + 1:1):' ,()') = 0);
        o_open = *on;
      endif;
      l_out += l_var;
    endif;

    if l_p2 >= %len(l_in);
      leave;
    endif;
    l_in = %subst(l_in:l_p2 + 1);
  enddo;

  return l_out;
end-proc;

// ------------------------------------------------------------------
// Splits comma separated operands outside quotes. Returns the count.
dcl-proc SplitItems;
  dcl-pi *n int(10);
    i_text varchar(512) const;
    o_items varchar(200) dim(C_MAXITEMS);
  end-pi;

  dcl-s l_i int(10);
  dcl-s l_cnt int(10) inz(0);
  dcl-s l_cur varchar(200) inz('');
  dcl-s l_inQuote ind inz(*off);
  dcl-s l_ch char(1);

  for l_i = 1 to %len(i_text);
    l_ch = %subst(i_text:l_i:1);
    if l_ch = C_QUOTE;
      l_inQuote = not l_inQuote;
    endif;
    if l_ch = ',' and not l_inQuote;
      if l_cnt < C_MAXITEMS;
        l_cnt += 1;
        o_items(l_cnt) = %trim(l_cur);
      endif;
      l_cur = '';
    else;
      l_cur += l_ch;
    endif;
  endfor;

  if %len(%trim(l_cur)) > 0 and l_cnt < C_MAXITEMS;
    l_cnt += 1;
    o_items(l_cnt) = %trim(l_cur);
  endif;
  return l_cnt;
end-proc;

// ------------------------------------------------------------------
// Splits KEY-value. A plain value (no key) comes back with an empty key.
dcl-proc SplitKey;
  dcl-pi *n;
    i_item varchar(200) const;
    o_key varchar(60);
    o_value varchar(200);
  end-pi;

  dcl-s l_p int(10);
  dcl-s l_key varchar(60);

  l_p = %scan('-':i_item);
  if l_p > 1;
    l_key = Up(%trim(%subst(i_item:1:l_p - 1)));
    if %scan(' ':l_key) = 0 and %scan(C_QUOTE:l_key) = 0;
      o_key = l_key;
      o_value = %trim(%subst(i_item:l_p + 1));
      return;
    endif;
  endif;
  o_key = '';
  o_value = %trim(i_item);
end-proc;

// ------------------------------------------------------------------
dcl-proc IsName;
  dcl-pi *n ind;
    i_name varchar(60) const;
    i_maxLen int(10) const;
  end-pi;

  if %len(i_name) = 0 or %len(i_name) > i_maxLen;
    return *off;
  endif;
  if %subst(i_name:1:1) = '&';
    return *on;                  // a variable made by Subst
  endif;
  return %check('ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_#@$':Up(i_name)) = 0;
end-proc;

// ------------------------------------------------------------------
dcl-proc ReviewLine;
  dcl-pi *n;
    i_lineNo int(10) const;
    i_text varchar(512) const;
    i_reason varchar(200) const;
  end-pi;

  AddComment('OCL: ' + i_text);
  RptItem(C_STS_REVIEW:i_lineNo:i_text:i_reason);
end-proc;

// ------------------------------------------------------------------
// // LOAD program[,library]   (the CALL is written when RUN arrives)
dcl-proc DoLoad;
  dcl-pi *n;
    i_lineNo int(10) const;
    i_text varchar(512) const;
    i_operands varchar(512) const;
  end-pi;

  dcl-s l_items varchar(200) dim(C_MAXITEMS);
  dcl-s l_cnt int(10);
  dcl-s l_ok ind;
  dcl-s l_name varchar(60);
  dcl-s l_lib varchar(60);

  if g_pendLoad;
    ReviewLine(g_loadLine:g_loadText
               :'LOAD was not followed by RUN before the next LOAD');
    g_pendLoad = *off;
  endif;

  l_cnt = SplitItems(i_operands:l_items);
  if l_cnt < 1 or l_cnt > 2;
    ReviewLine(i_lineNo:i_text
               :'LOAD operands not understood (expected program[,library])');
    return;
  endif;

  l_name = OperandExpr(l_items(1):l_ok);
  l_lib = '';
  if l_ok and l_cnt = 2;
    l_lib = OperandExpr(l_items(2):l_ok);
  endif;
  if not l_ok;
    ReviewLine(i_lineNo:i_text:'LOAD uses an expression that is not converted');
    return;
  endif;
  if not IsName(l_name:10) or (l_lib <> '' and not IsName(l_lib:10));
    ReviewLine(i_lineNo:i_text:'Program or library name is not a valid name');
    return;
  endif;

  g_pendLoad = *on;
  g_isSort = (l_name = '#GSORT');
  g_loadName = l_name;
  g_loadLib = l_lib;
  g_loadLine = i_lineNo;
  g_loadText = i_text;
end-proc;

// ------------------------------------------------------------------
dcl-proc DoRun;
  dcl-pi *n;
    i_lineNo int(10) const;
    i_text varchar(512) const;
    i_operands varchar(512) const;
  end-pi;

  dcl-s l_call varchar(200);

  g_afterRun = *on;
  if not g_pendLoad;
    ReviewLine(i_lineNo:i_text:'RUN without a LOAD');
    return;
  endif;

  if g_isSort;
    g_sortMode = *on;
    g_sortCond = *off;
    g_sortCnt = 0;
    g_sortSrcMbr = '';
    g_sortSrcLib = '';
    g_conditions = *off;
    g_sortFirst = i_lineNo;
    g_pendLoad = *off;
    return;
  endif;

  l_call = 'CALL PGM(';
  if g_loadLib <> '';
    l_call += g_loadLib + '/';
  endif;
  l_call += g_loadName + ')';
  AddBody(l_call);
  g_pendLoad = *off;
  // A FILE statement lasts for one step: remove its overrides after the call.
  if %len(g_ovr) > 0;
    AddBody('DLTOVR FILE(' + %trim(g_ovr) + ')');
    g_ovr = '';
  endif;

  select;
    when %len(%trim(i_operands)) > 0;
      AddComment('OCL: ' + i_text);
      RptItem(C_STS_REVIEW:i_lineNo:i_text:'RUN operands are not converted');
    other;
      RptItem(C_STS_CONVERTED:g_loadLine:g_loadText:'');
  endsl;
end-proc;

// ------------------------------------------------------------------
// // FILE NAME-x[,LABEL-y][,LIBRARY-z][,DISP-...]  ->  OVRDBF
dcl-proc DoFile;
  dcl-pi *n;
    i_lineNo int(10) const;
    i_text varchar(512) const;
    i_operands varchar(512) const;
  end-pi;

  dcl-s l_items varchar(200) dim(C_MAXITEMS);
  dcl-s l_cnt int(10);
  dcl-s l_i int(10);
  dcl-s l_ok ind;
  dcl-s l_bad ind inz(*off);
  dcl-s l_key varchar(60);
  dcl-s l_val varchar(200);
  dcl-s l_name varchar(60) inz('');
  dcl-s l_label varchar(60) inz('');
  dcl-s l_lib varchar(60) inz('');
  dcl-s l_disp varchar(60) inz('');
  dcl-s l_other varchar(200) inz('');
  dcl-s l_cmd varchar(200);
  dcl-s l_job ind inz(*off);
  dcl-s l_idx int(10);

  l_cnt = SplitItems(i_operands:l_items);
  if l_cnt < 1;
    ReviewLine(i_lineNo:i_text:'FILE operands not understood');
    return;
  endif;

  for l_i = 1 to l_cnt;
    SplitKey(l_items(l_i):l_key:l_val);
    l_ok = *on;
    select;
      when l_key = 'NAME';
        l_name = OperandExpr(l_val:l_ok);
      when l_key = 'LABEL';
        l_label = OperandExpr(l_val:l_ok);
      when l_key = 'LIBRARY';
        l_lib = OperandExpr(l_val:l_ok);
      when l_key = 'DISP';
        l_disp = Up(l_val);
      other;
        if l_key = 'JOB' and Up(l_val) = 'YES';
          l_job = *on;               // override for the whole job: not converted
        endif;
        if %len(l_other) > 0;
          l_other += ' ';
        endif;
        if l_key = '';
          l_other += l_val;
        else;
          l_other += l_key;
        endif;
    endsl;
    if not l_ok;
      l_bad = *on;
    endif;
  endfor;
  if l_bad;
    ReviewLine(i_lineNo:i_text
               :'NAME, LABEL or LIBRARY uses an expression that is not converted');
    return;
  endif;

  if l_label = '';
    l_label = l_name;
  endif;
  if not IsName(l_name:10) or not IsName(l_label:10)
     or (l_lib <> '' and not IsName(l_lib:10));
    ReviewLine(i_lineNo:i_text:'NAME, LABEL or LIBRARY is missing or not a valid name');
    return;
  endif;

  // Files of a #GSORT step become FMTDTA INFILE/OUTFILE (see FinishSort).
  if g_isSort and g_pendLoad and l_name = 'WORK';
    RptItem(C_STS_CONVERTED:i_lineNo:i_text
            :'Sort work file is ignored on the AS/400 system');
    return;
  endif;
  if g_isSort and g_pendLoad and (l_name = 'OUTPUT'
     or l_name = 'INPUT' or (%len(l_name) = 6 and %subst(l_name:1:5) = 'INPUT'
     and %check('12345678':%subst(l_name:6:1)) = 0));
    if l_name <> 'OUTPUT';
      if l_name = 'INPUT';
        l_idx = 1;
      else;
        l_idx = %int(%subst(l_name:6:1));
      endif;
      g_sortIn(l_idx) = l_label;
      g_sortInLib(l_idx) = l_lib;
    else;
      g_sortOut = l_label;
      g_sortOutLib = l_lib;
      g_sortExtra = l_other;
    endif;
    RptItem(C_STS_CONVERTED:i_lineNo:i_text:'');
    return;
  endif;
  if l_disp = 'NEW';
    ReviewLine(i_lineNo:i_text
               :'DISP-NEW (creating the file) is not converted');
    return;
  endif;

  l_cmd = 'OVRDBF FILE(' + l_name + ') TOFILE(';
  if l_lib <> '';
    l_cmd += l_lib + '/';
  endif;
  l_cmd += l_label + ')';
  AddBody(l_cmd);
  if not l_job and %scan(' ' + l_name + ' ':' ' + g_ovr + ' ') = 0;
    if %len(g_ovr) > 0;
      g_ovr += ' ';
    endif;
    g_ovr += l_name;
  endif;

  select;
    when l_other <> '';
      AddComment('OCL: ' + i_text);
      RptItem(C_STS_REVIEW:i_lineNo:i_text
              :'Keywords not converted: ' + l_other);
    when l_disp <> '';
      RptItem(C_STS_ASSUMPTION:i_lineNo:i_text
              :'DISP-' + l_disp + ' not converted; OVRDBF default sharing applies');
    other;
      RptItem(C_STS_CONVERTED:i_lineNo:i_text:'');
  endsl;
end-proc;

// ------------------------------------------------------------------
// // LOCAL OFFSET-n,DATA-'text'[,AREA-USER]  ->  CHGDTAARA on *LDA
// IBM's guide shows OFFSET as a 1-based position (for example OFFSET-1).
// The local data area is the S/36 local data area, so *LDA is assumed.
dcl-proc DoLocal;
  dcl-pi *n;
    i_lineNo int(10) const;
    i_text varchar(512) const;
    i_operands varchar(512) const;
  end-pi;

  dcl-s l_items varchar(200) dim(C_MAXITEMS);
  dcl-s l_cnt int(10);
  dcl-s l_i int(10);
  dcl-s l_key varchar(60);
  dcl-s l_val varchar(200);
  dcl-s l_offset varchar(60) inz('');
  dcl-s l_data varchar(200) inz('');
  dcl-s l_hasData ind inz(*off);
  dcl-s l_other ind inz(*off);
  dcl-s l_open ind;
  dcl-s l_chk varchar(512);
  dcl-s l_len int(10);
  dcl-s l_pos int(10);
  dcl-s l_var varchar(20);

  l_cnt = SplitItems(i_operands:l_items);
  for l_i = 1 to l_cnt;
    SplitKey(l_items(l_i):l_key:l_val);
    select;
      when l_key = 'OFFSET';
        l_offset = l_val;
      when l_key = 'DATA';
        l_data = l_val;
        l_hasData = *on;
      when l_key = 'AREA' and Up(l_val) = 'USER';
        // accepted, no effect on the output
      other;
        l_other = *on;
    endsl;
  endfor;

  if l_cnt < 1 or l_other or not l_hasData
     or %len(l_offset) = 0 or %len(l_offset) > 5
     or %check('0123456789':l_offset) > 0;
    ReviewLine(i_lineNo:i_text
               :'LOCAL needs OFFSET-n and DATA-value (AREA-USER allowed) only');
    return;
  endif;
  l_pos = %int(l_offset);
  if l_pos < 1;
    ReviewLine(i_lineNo:i_text:'OFFSET 0 is not a valid 1-based position');
    return;
  endif;

  // Strip the quotes round the data.
  if %len(l_data) >= 2 and %subst(l_data:1:1) = C_QUOTE
     and %subst(l_data:%len(l_data):1) = C_QUOTE;
    l_data = %subst(l_data:2:%len(l_data) - 2);
  endif;

  // DATA that is one expression (?DATE?, ?USER?, ?L'p,n'?) uses its variable.
  if %len(l_data) >= 3 and %subst(l_data:1:1) = '?'
     and %subst(l_data:%len(l_data):1) = '?'
     and %scan('?':l_data:2) = %len(l_data);
    l_var = ExprVar(%subst(l_data:2:%len(l_data) - 2):l_len);
    if l_var <> '' and %subst(l_var:1:2) <> '&P';
      AddBody('CHGDTAARA DTAARA(*LDA (' + %trim(%char(l_pos)) + ' '
              + %trim(%char(l_len)) + ')) VALUE(' + l_var + ')');
      RptItem(C_STS_ASSUMPTION:i_lineNo:i_text
              :'OFFSET taken as a 1-based position in the local data area (*LDA)'
              + '; value comes from ' + %subst(l_data:1:%len(l_data)));
      return;
    endif;
  endif;

  // Other substitution inside the data cannot be expressed by CHGDTAARA VALUE.
  l_chk = Subst(l_data:l_open);
  if l_open or l_chk <> l_data or %len(l_data) = 0;
    ReviewLine(i_lineNo:i_text
               :'DATA is empty or uses a substitution expression');
    return;
  endif;

  l_len = %len(%scanrpl('''''':' ':l_data));
  AddBody('CHGDTAARA DTAARA(*LDA (' + %trim(%char(l_pos)) + ' '
          + %trim(%char(l_len)) + ')) VALUE(' + C_QUOTE + l_data
          + C_QUOTE + ')');
  RptItem(C_STS_ASSUMPTION:i_lineNo:i_text
          :'OFFSET taken as a 1-based position in the local data area (*LDA)');
end-proc;

// ------------------------------------------------------------------
// // EVALUATE Pn[,len]=expression ...   (items separated by blanks)
// Parameters are CL variables. A parameter first assigned here (before any
// ?n? read) is a local variable; one read first is a passed parameter.
// Converted: a text or number constant, ?USER?, ?WS?, ?DATE?, ?L'p,n'?,
// ?n?. Arithmetic and other expressions are reported for review.
dcl-proc DoEvaluate;
  dcl-pi *n;
    i_lineNo int(10) const;
    i_text varchar(512) const;
    i_operands varchar(512) const;
  end-pi;

  dcl-s l_i int(10);
  dcl-s l_ch char(1);
  dcl-s l_inQ ind inz(*off);
  dcl-s l_item varchar(300) inz('');
  dcl-s l_items varchar(300) dim(C_MAXITEMS);
  dcl-s l_cnt int(10) inz(0);
  dcl-s l_k int(10);
  dcl-s l_eq int(10);
  dcl-s l_lhs varchar(60);
  dcl-s l_expr varchar(300);
  dcl-s l_cm int(10);
  dcl-s l_nStr varchar(10);
  dcl-s l_lenStr varchar(10);
  dcl-s l_n int(10);
  dcl-s l_len int(10);
  dcl-s l_val varchar(300);
  dcl-s l_var varchar(20);
  dcl-s l_vlen int(10);
  dcl-s l_numeric ind;
  dcl-s l_cmt varchar(300) inz('');
  dcl-s l_bad ind inz(*off);
  dcl-s l_note ind inz(*off);

  // Split at blanks outside apostrophes and outside ?...? expressions.
  dcl-s l_inE ind inz(*off);
  for l_i = 1 to %len(i_operands);
    l_ch = %subst(i_operands:l_i:1);
    if l_ch = C_QUOTE;
      l_inQ = not l_inQ;
    elseif l_ch = '?' and not l_inQ;
      l_inE = not l_inE;
    endif;
    if l_ch = ' ' and not l_inQ and not l_inE;
      if %len(l_item) > 0 and l_cnt < C_MAXITEMS;
        l_cnt += 1;
        l_items(l_cnt) = l_item;
      endif;
      l_item = '';
    else;
      l_item += l_ch;
    endif;
  endfor;
  if %len(l_item) > 0 and l_cnt < C_MAXITEMS;
    l_cnt += 1;
    l_items(l_cnt) = l_item;
  endif;

  for l_k = 1 to l_cnt;
    l_eq = %scan('=':l_items(l_k));
    if %subst(Up(l_items(l_k)):1:1) <> 'P' or l_eq < 3;
      // Not an assignment: anything not recognised is a comment.
      if %len(l_cmt) > 0;
        l_cmt += ' ';
      endif;
      l_cmt += l_items(l_k);
      iter;
    endif;

    l_lhs = %subst(l_items(l_k):2:l_eq - 2);
    l_expr = %subst(l_items(l_k):l_eq + 1);
    l_cm = %scan(',':l_lhs);
    if l_cm = 0;
      l_nStr = l_lhs;
      l_lenStr = '';
    else;
      l_nStr = %subst(l_lhs:1:l_cm - 1);
      l_lenStr = %subst(l_lhs:l_cm + 1);
    endif;
    if %len(l_nStr) = 0 or %len(l_nStr) > 2
       or %check('0123456789':l_nStr) > 0
       or (%len(l_lenStr) > 0 and (%len(l_lenStr) > 2
       or %check('0123456789':l_lenStr) > 0));
      ReviewLine(i_lineNo:i_text
                 :'EVALUATE item ' + l_items(l_k)
                 + ' is not converted (parameter number or length is an expression)');
      l_bad = *on;
      iter;
    endif;
    l_n = %int(l_nStr);
    l_len = 0;
    if %len(l_lenStr) > 0;
      l_len = %int(l_lenStr);
    endif;
    if l_n < 1 or l_n > 40;
      ReviewLine(i_lineNo:i_text
                 :'EVALUATE parameter P' + l_nStr + ' is outside 1 to 40');
      l_bad = *on;
      iter;
    endif;

    // The value
    l_var = '';
    l_val = '';
    l_numeric = *off;
    l_vlen = 0;
    select;
      when l_expr = '''''';
        l_val = ' ';
        l_vlen = 1;
      when %len(l_expr) >= 2 and %subst(l_expr:1:1) = C_QUOTE
           and %subst(l_expr:%len(l_expr):1) = C_QUOTE;
        l_val = %subst(l_expr:2:%len(l_expr) - 2);
        l_vlen = %len(%scanrpl('''''':' ':l_val));
      when %subst(l_expr:1:1) = '?';
        if %len(l_expr) >= 3 and %scan('?':l_expr:2) = %len(l_expr);
          l_var = ExprVar(%subst(l_expr:2:%len(l_expr) - 2):l_vlen);
        endif;
        if l_var = '';
          ReviewLine(i_lineNo:i_text
                     :'EVALUATE value ' + l_expr + ' is not converted');
          l_bad = *on;
          iter;
        endif;
      when %scan('?':l_expr) > 0 or %scan('+':l_expr) > 0
           or %scan('\':l_expr) > 0 or %scan('/':l_expr) > 0
           or %scan('(':l_expr) > 0 or %scan('-':l_expr) > 0
           or %scan('*':l_expr) > 0 or %len(l_expr) = 0;
        ReviewLine(i_lineNo:i_text
                   :'EVALUATE value ' + l_expr
                   + ' (arithmetic or mixed expression) is not converted');
        l_bad = *on;
        iter;
      other;
        l_val = l_expr;
        l_numeric = %check('0123456789':l_expr) = 0;
        if l_numeric;
          // digits only: leading zeros dropped, or padded/cut to the length
          dow %len(l_val) > 1 and %subst(l_val:1:1) = '0';
            l_val = %subst(l_val:2);
          enddo;
          if l_len > 0;
            if %len(l_val) > l_len;
              l_val = %subst(l_val:%len(l_val) - l_len + 1);
            else;
              l_val = %subst('000000000000000':1:l_len - %len(l_val)) + l_val;
            endif;
          endif;
        endif;
        l_vlen = %len(l_val);
    endsl;

    if g_parKind(l_n) = ' ';
      g_parKind(l_n) = 'L';
    endif;
    if g_parKind(l_n) = 'L';
      g_parLen(l_n) = %max(g_parLen(l_n):%max(l_vlen:1));
    else;
      l_note = *on;
    endif;

    if l_var <> '';
      AddBody('CHGVAR VAR(&P' + %trim(%char(l_n)) + ') VALUE(' + l_var + ')');
    else;
      AddBody('CHGVAR VAR(&P' + %trim(%char(l_n)) + ') VALUE(' + C_QUOTE
              + l_val + C_QUOTE + ')');
    endif;
  endfor;

  if %len(l_cmt) > 0;
    AddComment(l_cmt);
  endif;
  if not l_bad;
    if l_note;
      RptItem(C_STS_ASSUMPTION:i_lineNo:i_text
              :'Assigned parameter is also passed by the caller (CHAR(10))');
    else;
      RptItem(C_STS_CONVERTED:i_lineNo:i_text:'');
    endif;
  endif;
end-proc;

// ------------------------------------------------------------------
// // TAG name  and  // GOTO name
dcl-proc DoTagGoto;
  dcl-pi *n;
    i_lineNo int(10) const;
    i_text varchar(512) const;
    i_isTag ind const;
    i_operands varchar(512) const;
  end-pi;

  dcl-s l_label varchar(60);
  dcl-s l_extra varchar(512) inz('');
  dcl-s l_p int(10);

  l_label = Up(%trim(i_operands));
  l_p = %scan(' ':l_label);
  if l_p > 0;                      // text after the label is a comment
    l_extra = %trim(%subst(%trim(i_operands):l_p + 1));
    l_label = %subst(l_label:1:l_p - 1);
  endif;
  if not IsName(l_label:10) or %scan(' ':l_label) > 0
     or %subst(l_label:1:1) = '&';
    ReviewLine(i_lineNo:i_text:'Label is not a valid CL label (10 characters)');
    return;
  endif;

  if i_isTag;
    AddBody(l_label + ':');
  else;
    AddBody('GOTO CMDLBL(' + l_label + ')');
  endif;
  if %len(l_extra) > 0;
    AddComment(l_extra);
  endif;
  RptItem(C_STS_CONVERTED:i_lineNo:i_text:'');
end-proc;

// ------------------------------------------------------------------
// Text for a CL literal piece: every quote doubled once for the SQL
// statement and once more for the CL literal.
dcl-proc QuoteSpec;
  dcl-pi *n varchar(512);
    i_text varchar(512) const;
  end-pi;

  return %scanrpl(C_QUOTE:C_QUOTE + C_QUOTE + C_QUOTE + C_QUOTE:i_text);
end-proc;

// ------------------------------------------------------------------
dcl-proc AddTmp;
  dcl-pi *n;
    i_text varchar(512) const;
  end-pi;

  if g_tmpCnt >= C_MAXTMP;
    g_overflow = *on;
    return;
  endif;
  g_tmpCnt += 1;
  g_tmp(g_tmpCnt) = i_text;
end-proc;

// ------------------------------------------------------------------
// Maps the inside of a ?...? expression to a CL variable name.
// ?1? to ?9? -> &P1..&P9, ?L'p,n'? -> &Lp_n (local data area text).
// Returns '' when the expression is not supported.
dcl-proc SortVar;
  dcl-pi *n varchar(20);
    i_tok varchar(60) const;
  end-pi;

  dcl-s l_t varchar(60);
  dcl-s l_cp int(10);
  dcl-s l_ps varchar(60);
  dcl-s l_ns varchar(60);
  dcl-s l_p int(10);
  dcl-s l_n int(10);
  dcl-s l_i int(10);
  dcl-s l_found ind;

  l_t = Up(%trim(i_tok));
  if %len(l_t) = 1 and %check('123456789':l_t) = 0;
    UseParm(%int(l_t));
    return '&P' + l_t;
  endif;

  if %len(l_t) >= 6 and %subst(l_t:1:2) = 'L''' 
     and %subst(l_t:%len(l_t):1) = '''';
    l_cp = %scan(',':l_t);
    if l_cp < 4;
      return '';
    endif;
    l_ps = %subst(l_t:3:l_cp - 3);
    l_ns = %subst(l_t:l_cp + 1:%len(l_t) - l_cp - 1);
    if %len(l_ps) = 0 or %len(l_ps) > 4 or %len(l_ns) = 0
       or %len(l_ns) > 3 or %check('0123456789':l_ps) > 0
       or %check('0123456789':l_ns) > 0;
      return '';
    endif;
    l_p = %int(l_ps);
    l_n = %int(l_ns);
    if l_p < 1 or l_n < 1 or l_p + l_n > 1025;
      return '';
    endif;

    l_found = *off;
    for l_i = 1 to g_blkCnt;
      if g_blkP(l_i) = l_p and g_blkN(l_i) = l_n;
        l_found = *on;
      endif;
    endfor;
    if not l_found and g_blkCnt < C_MAXLDA;
      g_blkCnt += 1;
      g_blkP(g_blkCnt) = l_p;
      g_blkN(g_blkCnt) = l_n;
    endif;
    l_found = *off;
    for l_i = 1 to g_ldaCnt;
      if g_ldaP(l_i) = l_p and g_ldaN(l_i) = l_n;
        l_found = *on;
      endif;
    endfor;
    if not l_found and g_ldaCnt < C_MAXLDA;
      g_ldaCnt += 1;
      g_ldaP(g_ldaCnt) = l_p;
      g_ldaN(g_ldaCnt) = l_n;
    endif;
    return '&L' + %trim(%char(l_p)) + '_' + %trim(%char(l_n));
  endif;
  return '';
end-proc;

// ------------------------------------------------------------------
// Writes the two statements that insert one specification line into the
// QTEMP source member. ?...? expressions inside the line are replaced by
// the value of a CL variable. Returns *OFF when an expression is not
// supported (o_why says which).
dcl-proc SortInsert;
  dcl-pi *n ind;
    i_member varchar(10) const;
    i_seq int(10) const;
    i_spec varchar(512) const;
    o_why varchar(100);
  end-pi;

  dcl-s l_stmt varchar(512);
  dcl-s l_rest varchar(512);
  dcl-s l_p1 int(10);
  dcl-s l_p2 int(10);
  dcl-s l_lit varchar(512);
  dcl-s l_var varchar(20);
  dcl-s l_pos int(10);
  dcl-s l_len int(10);
  dcl-s l_piece varchar(512);

  l_stmt = 'CHGVAR VAR(&SQL) VALUE(' + C_QUOTE + 'INSERT INTO QTEMP/'
           + i_member + ' VALUES(' + %trim(%char(i_seq)) + ',0,'
           + C_QUOTE + C_QUOTE + C_QUOTE;
  l_rest = i_spec;
  dow %len(l_rest) > 0;
    l_p1 = %scan('?':l_rest);
    if l_p1 = 0;
      l_lit = l_rest;
      l_rest = '';
    else;
      l_p2 = %scan('?':l_rest:l_p1 + 1);
      if l_p2 = 0;
        o_why = 'Unmatched ? in a specification line';
        return *off;
      endif;
      l_var = SortVar(%subst(l_rest:l_p1 + 1:l_p2 - l_p1 - 1));
      if l_var = '';
        o_why = 'Substitution expression ' + %subst(l_rest:l_p1:l_p2 - l_p1 + 1)
                + ' is not supported in sort specifications';
        return *off;
      endif;
      if l_p1 > 1;
        l_lit = %subst(l_rest:1:l_p1 - 1);
      else;
        l_lit = '';
      endif;
      l_rest = %subst(l_rest:l_p2 + 1);
    endif;

    // The literal part is cut into short pieces joined by *CAT so the CL
    // line can wrap between them.
    l_pos = 1;
    l_len = %len(l_lit);
    dow l_pos <= l_len;
      l_piece = %subst(l_lit:l_pos:%min(30:l_len - l_pos + 1));
      l_stmt += ' *CAT ' + C_QUOTE + QuoteSpec(l_piece) + C_QUOTE;
      l_pos += 30;
    enddo;
    if l_p1 > 0;
      l_stmt += ' *CAT ' + l_var;
    endif;
  enddo;
  l_stmt += ' *CAT ' + C_QUOTE + C_QUOTE + C_QUOTE + ')' + C_QUOTE + ')';
  AddTmp(l_stmt);
  AddTmp('RUNSQL SQL(&SQL) COMMIT(*NONE) NAMING(*SYS)');
  return *on;
end-proc;

// ------------------------------------------------------------------
// Analyses a conditional line  // IF|IFT|IFF cond spec   or  // ELSE spec.
// o_kind: 'I' (IF, IFT), 'F' (IFF) or 'E' (ELSE). For IF/IFF the condition
// must be  ?expr?/value  or  ?expr?=value. o_spec is the text after the
// condition (one blank separates them), empty when there is none.
dcl-proc SortCond;
  dcl-pi *n ind;
    i_line varchar(512) const;
    o_kind char(1);
    o_var varchar(20);
    o_lit varchar(128);
    o_spec varchar(512);
    o_why varchar(100);
  end-pi;

  dcl-s l_t varchar(512);
  dcl-s l_p int(10);
  dcl-s l_q int(10);
  dcl-s l_kw varchar(10);
  dcl-s l_cond varchar(512);
  dcl-s l_left varchar(512);
  dcl-s l_right varchar(512);
  dcl-s l_i int(10);
  dcl-s l_inQ ind;
  dcl-s l_inE ind;
  dcl-s l_ch char(1);
  dcl-s l_split int(10);
  dcl-s l_w varchar(10);

  o_var = '';
  o_lit = '';
  o_spec = '';
  l_t = %trimr(i_line);
  l_p = 3;
  dow l_p <= %len(l_t) and %subst(l_t:l_p:1) = ' ';
    l_p += 1;
  enddo;
  l_q = %scan(' ':l_t:l_p);
  if l_q = 0;
    l_kw = Up(%subst(l_t:l_p));
    l_q = %len(l_t) + 1;
  else;
    l_kw = Up(%subst(l_t:l_p:l_q - l_p));
  endif;

  if l_kw = 'ELSE';
    o_kind = 'E';
    if l_q < %len(l_t);
      o_spec = %subst(l_t:l_q + 1);
    endif;
  else;
    if l_kw = 'IF' or l_kw = 'IFT';
      o_kind = 'I';
    else;
      o_kind = 'F';
    endif;
    l_p = l_q;
    dow l_p <= %len(l_t) and %subst(l_t:l_p:1) = ' ';
      l_p += 1;
    enddo;
    // The condition ends at the first blank outside apostrophes.
    l_inQ = *off;
    l_i = l_p;
    dow l_i <= %len(l_t);
      if %subst(l_t:l_i:1) = C_QUOTE;
        l_inQ = not l_inQ;
      endif;
      if %subst(l_t:l_i:1) = ' ' and not l_inQ;
        leave;
      endif;
      l_i += 1;
    enddo;
    l_cond = %subst(l_t:l_p:l_i - l_p);
    if l_i < %len(l_t);
      o_spec = %subst(l_t:l_i + 1);
    endif;

    // Split at the first / or = outside ?...? and apostrophes.
    l_split = 0;
    l_inQ = *off;
    l_inE = *off;
    for l_i = 1 to %len(l_cond);
      l_ch = %subst(l_cond:l_i:1);
      if l_ch = C_QUOTE;
        l_inQ = not l_inQ;
      elseif l_ch = '?' and not l_inQ;
        l_inE = not l_inE;
      elseif (l_ch = '/' or l_ch = '=') and not l_inQ and not l_inE;
        l_split = l_i;
        leave;
      endif;
    endfor;
    if l_split < 3;
      o_why = 'Condition is not of the form ?expression?/value';
      return *off;
    endif;
    l_left = %subst(l_cond:1:l_split - 1);
    if l_split < %len(l_cond);
      l_right = %subst(l_cond:l_split + 1);
    else;
      l_right = '';
    endif;
    if %len(l_left) < 3 or %subst(l_left:1:1) <> '?'
       or %subst(l_left:%len(l_left):1) <> '?';
      o_why = 'Left side of the condition is not a substitution expression';
      return *off;
    endif;
    o_var = SortVar(%subst(l_left:2:%len(l_left) - 2));
    if o_var = '';
      o_why = 'Condition expression ' + l_left + ' is not supported';
      return *off;
    endif;
    if %scan('?':l_right) > 0;
      o_why = 'Right side of the condition uses an expression';
      return *off;
    endif;
    if %len(l_right) >= 2 and %subst(l_right:1:1) = C_QUOTE
       and %subst(l_right:%len(l_right):1) = C_QUOTE;
      l_right = %scanrpl('''''':'''':%subst(l_right:2:%len(l_right) - 2));
    endif;
    if %len(l_right) = 0;
      l_right = ' ';
    endif;
    o_lit = l_right;
  endif;

  // A nested IF in the statement part is not converted.
  l_w = Up(%subst(%trim(o_spec) + '    ':1:4));
  if %subst(l_w:1:3) = 'IF ' or %subst(l_w:1:4) = 'IFF '
     or %subst(l_w:1:4) = 'IFT ' or %subst(l_w:1:5) = 'ELSE ';
    o_why = 'Nested IF/ELSE on one line is not converted';
    return *off;
  endif;
  return *on;
end-proc;

// ------------------------------------------------------------------
// Writes the collected #GSORT step as FMTDTA. The specification lines
// (copied unchanged) are inserted into a QTEMP source member by CL at run
// time, so conditional lines (// IF, // IFF, // ELSE) can test the local
// data area or a parameter when the program runs. Anything that cannot be
// converted leaves the whole block as comments.
dcl-proc FinishSort;
  dcl-pi *n;
  end-pi;

  dcl-s l_i int(10);
  dcl-s l_n varchar(10);
  dcl-s l_kind char(1);
  dcl-s l_var varchar(20);
  dcl-s l_lit varchar(128);
  dcl-s l_spec varchar(512);
  dcl-s l_why varchar(100);
  dcl-s l_ok ind inz(*on);
  dcl-s l_lastKind char(1) inz(' ');
  dcl-s l_lastVar varchar(20) inz('');
  dcl-s l_lastLit varchar(128) inz('');
  dcl-s l_cond varchar(200);
  dcl-s l_op varchar(5);
  dcl-s l_seq int(10) inz(0);
  dcl-s l_in varchar(300) inz('');
  dcl-s l_inCnt int(10) inz(0);
  dcl-s l_out varchar(130);
  dcl-s l_cmd varchar(512);
  dcl-s l_hasCond ind inz(*off);
  dcl-s l_ref varchar(130);

  g_sortMode = *off;
  g_sortNo += 1;
  l_n = 'IASORT' + %trim(%char(g_sortNo));
  g_blkCnt = 0;
  g_tmpCnt = 0;

  // Files
  for l_i = 1 to 8;
    if g_sortIn(l_i) <> '';
      l_ref = g_sortIn(l_i);
      if g_sortInLib(l_i) <> '';
        l_ref = g_sortInLib(l_i) + '/' + g_sortIn(l_i);
      endif;
      l_inCnt += 1;
      if l_inCnt = 1;
        l_in = l_ref;
      else;
        l_in += ' ' + l_ref;
      endif;
    endif;
  endfor;
  if g_sortOut <> '' and g_sortOutLib <> '';
    l_out = g_sortOutLib + '/' + g_sortOut;
  else;
    l_out = g_sortOut;
  endif;
  if l_inCnt = 0 or g_sortOut = '';
    l_ok = *off;
    l_why = 'FILE NAME-INPUT and NAME-OUTPUT are both needed';
  endif;
  if l_ok and g_sortSrcMbr = '' and g_sortCnt = 0;
    l_ok = *off;
    l_why = 'No sort specification lines found';
  endif;

  // Specification lines
  if l_ok and g_sortSrcMbr = '';
    for l_i = 1 to g_sortCnt;
      l_hasCond = *off;
      if %len(%trim(g_sortLines(l_i))) >= 2
         and %subst(%trim(g_sortLines(l_i)):1:2) = '//';
        if not SortCond(g_sortLines(l_i):l_kind:l_var:l_lit:l_spec:l_why);
          l_ok = *off;
          leave;
        endif;
        l_hasCond = *on;
        if l_kind = 'E';
          if l_lastKind = ' ';
            l_ok = *off;
            l_why = 'ELSE without a preceding IF on the line before';
            leave;
          endif;
          l_var = l_lastVar;
          l_lit = l_lastLit;
          if l_lastKind = 'I';
            l_kind = 'F';
          else;
            l_kind = 'I';
          endif;
          l_lastKind = ' ';
        else;
          l_lastKind = l_kind;
          l_lastVar = l_var;
          l_lastLit = l_lit;
        endif;
        if %len(%trim(l_spec)) = 0;
          l_ok = *off;
          l_why = 'IF/ELSE line has no specification text after the condition';
          leave;
        endif;
        // The statement part supplies columns 4 onward of the line.
        l_spec = %trimr('   ' + l_spec);
        if %len(l_spec) < 6 or (%subst(l_spec:6:1) <> 'H'
           and %subst(l_spec:6:1) <> 'I' and %subst(l_spec:6:1) <> 'F');
          l_ok = *off;
          l_why = 'Text after the condition is not a sort specification';
          leave;
        endif;
      else;
        l_spec = g_sortLines(l_i);
        l_lastKind = ' ';
      endif;

      l_seq += 1;
      if l_hasCond;
        if l_kind = 'I';
          l_op = '*EQ';
        else;
          l_op = '*NE';
        endif;
        l_cond = l_var + ' ' + l_op + ' ' + C_QUOTE
                 + %scanrpl(C_QUOTE:C_QUOTE + C_QUOTE:l_lit) + C_QUOTE;
        AddTmp('IF COND(' + l_cond + ') THEN(DO)');
      endif;
      if not SortInsert(l_n:l_seq:l_spec:l_why);
        l_ok = *off;
        leave;
      endif;
      if l_hasCond;
        AddTmp('ENDDO');
      endif;
    endfor;
  endif;

  if g_sortSrcMbr <> '' and g_sortSrcLib = '#LIBRARY';
    l_ok = *off;
    l_why = 'SOURCE with #LIBRARY is not converted';
  endif;

  if not l_ok or g_overflow;
    AddComment('OCL: sort step (#GSORT) not converted');
    for l_i = 1 to g_sortCnt;
      AddCommentRaw(' ' + g_sortLines(l_i));
    endfor;
    RptItem(C_STS_REVIEW:g_sortFirst:'#GSORT step':l_why);
    return;
  endif;

  g_useSql = *on;
  if g_sortSrcMbr <> '';
    AddBody('FMTDTA INFILE(' + %trim(l_in) + ') OUTFILE(' + l_out
            + ') SRCFILE(' + g_sortSrcLib + '/QS36SRC) SRCMBR('
            + g_sortSrcMbr + ')');
    RptItem(C_STS_ASSUMPTION:g_sortFirst:'#GSORT step'
            :'// SOURCE member read from file QS36SRC in the named library');
  else;
    for l_i = 1 to g_blkCnt;
      AddBody('RTVDTAARA DTAARA(*LDA (' + %trim(%char(g_blkP(l_i))) + ' '
              + %trim(%char(g_blkN(l_i))) + ')) RTNVAR(&L'
              + %trim(%char(g_blkP(l_i))) + '_'
              + %trim(%char(g_blkN(l_i))) + ')');
    endfor;
    AddBody('DLTF FILE(QTEMP/' + l_n + ')');
    AddBody('MONMSG MSGID(CPF2105)');
    AddBody('CRTSRCPF FILE(QTEMP/' + l_n + ') RCDLEN(112) MBR(' + l_n
            + ') CCSID(65535)');
    for l_i = 1 to g_tmpCnt;
      AddBody(g_tmp(l_i));
    endfor;
    l_cmd = 'FMTDTA INFILE(';
    if l_inCnt > 1;
      l_cmd += '(' + %scanrpl(' ':') (':%trim(l_in)) + ')';
    else;
      l_cmd += %trim(l_in);
    endif;
    l_cmd += ') OUTFILE(' + l_out + ') SRCFILE(QTEMP/' + l_n + ') SRCMBR('
             + l_n + ')';
    AddBody(l_cmd);
    RptItem(C_STS_ASSUMPTION:g_sortFirst:'#GSORT step'
            :'Mapped to FMTDTA; specification lines are copied unchanged into '
            + 'QTEMP/' + l_n + ' (CCSID 65535) by RUNSQL');
  endif;

  if g_conditions;
    RptItem(C_STS_ASSUMPTION:g_sortFirst:'#GSORT conditions'
            :'IF/IFF/ELSE compared as text; statement text taken to start at '
            + 'column 4 of the specification line');
  endif;
  if g_sortExtra <> '';
    RptItem(C_STS_REVIEW:g_sortFirst:'FILE NAME-OUTPUT'
            :'Output file keywords not converted: ' + g_sortExtra
            + '. Create the output file before FMTDTA if it does not exist');
  endif;
end-proc;

// ------------------------------------------------------------------
// The data lines of a #GSORT step are collected until // END, /*, // SOURCE
// or the next statement. Returns *ON when the line was taken as part of
// the block.
dcl-proc SortLine;
  dcl-pi *n ind;
    i_lineNo int(10) const;
    i_text varchar(512) const;
  end-pi;

  dcl-s l_t varchar(512);
  dcl-s l_kw varchar(60);
  dcl-s l_p int(10);
  dcl-s l_items varchar(200) dim(C_MAXITEMS);
  dcl-s l_cnt int(10);

  l_t = %trim(i_text);
  if %len(l_t) = 0;
    return *on;
  endif;

  if %len(l_t) >= 2 and %subst(l_t:1:2) = '//';
    l_p = %scan(' ':l_t:3);
    if l_p = 0;
      l_kw = Up(%trim(%subst(l_t:3)));
    else;
      l_kw = Up(%trim(%subst(l_t:3:l_p - 3)));
    endif;
    select;
      when l_kw = 'END';             // ends the inline data of the step
        FinishSort();
        RptItem(C_STS_CONVERTED:i_lineNo:i_text:'');
        return *on;
      when l_kw = 'SOURCE';          // specifications come from a member
        if l_p > 0;
          l_cnt = SplitItems(%trim(%subst(l_t:l_p + 1)):l_items);
        else;
          l_cnt = 0;
        endif;
        if l_cnt = 2;
          g_sortSrcMbr = Up(l_items(1));
          g_sortSrcLib = Up(l_items(2));
        endif;
        FinishSort();
        RptItem(C_STS_CONVERTED:i_lineNo:i_text:'');
        return *on;
      when l_kw = 'IF' or l_kw = 'IFT' or l_kw = 'IFF' or l_kw = 'ELSE';
        g_conditions = *on;
        if g_sortCnt < C_MAXSORT;
          g_sortCnt += 1;
          g_sortLines(g_sortCnt) = %trimr(i_text);
        else;
          g_overflow = *on;
        endif;
        return *on;
      other;
        FinishSort();
        return *off;
    endsl;
  endif;

  if %subst(l_t:1:1) = '/' and %len(l_t) >= 2
     and (%subst(l_t:2:1) = '*' or %subst(l_t:2:1) = '&');
    FinishSort();
    RptItem(C_STS_CONVERTED:i_lineNo:i_text:'');
    return *on;
  endif;

  if g_sortCnt < C_MAXSORT;
    g_sortCnt += 1;
    g_sortLines(g_sortCnt) = %trimr(i_text);
  else;
    g_overflow = *on;
  endif;
  return *on;
end-proc;

// ------------------------------------------------------------------
// Removes a trailing comment  /\ text \/  (outside quotes) from the
// statement text and returns its text (empty when there is none).
dcl-proc StripTrailing;
  dcl-pi *n varchar(512);
    io_s varchar(512);
  end-pi;

  dcl-s l_i int(10);
  dcl-s l_inQuote ind inz(*off);
  dcl-s l_cmt varchar(512) inz('');

  for l_i = 1 to %len(io_s) - 1;
    if %subst(io_s:l_i:1) = C_QUOTE;
      l_inQuote = not l_inQuote;
    endif;
    if not l_inQuote and %subst(io_s:l_i:2) = '/\';
      l_cmt = %trim(%subst(io_s:l_i + 2));
      io_s = %trim(%subst(io_s:1:l_i - 1));
      if %len(l_cmt) >= 2 and %subst(l_cmt:%len(l_cmt) - 1:2) = '\/';
        l_cmt = %trim(%subst(l_cmt:1:%len(l_cmt) - 2));
      endif;
      return l_cmt;
    endif;
  endfor;
  return '';
end-proc;

// ------------------------------------------------------------------
// One operand of a condition as a CL operand: a variable for a single
// ?...? expression, otherwise a quoted constant. '' when not supported.
dcl-proc CondOperand;
  dcl-pi *n varchar(60);
    i_t varchar(200) const;
  end-pi;

  dcl-s l_len int(10);
  dcl-s l_v varchar(200);

  if %len(i_t) = 0;
    return C_QUOTE + ' ' + C_QUOTE;
  endif;
  if %subst(i_t:1:1) = '?';
    if %len(i_t) >= 3 and %subst(i_t:%len(i_t):1) = '?'
       and %scan('?':i_t:2) = %len(i_t);
      return ExprVar(%subst(i_t:2:%len(i_t) - 2):l_len);
    endif;
    return '';
  endif;
  if %scan('?':i_t) > 0;
    return '';
  endif;
  l_v = i_t;
  if %len(l_v) >= 2 and %subst(l_v:1:1) = C_QUOTE
     and %subst(l_v:%len(l_v):1) = C_QUOTE;
    l_v = %subst(l_v:2:%len(l_v) - 2);   // inner text, doubled quotes kept
  else;
    l_v = %scanrpl(C_QUOTE:C_QUOTE + C_QUOTE:l_v);
  endif;
  if %len(l_v) = 0;
    l_v = ' ';
  endif;
  return C_QUOTE + l_v + C_QUOTE;
end-proc;

// ------------------------------------------------------------------
// A condition string as a CL expression: value1/value2 and value1=value2
// (equal, compared as text) and SWITCHn-0 / SWITCHn-1. '' when the
// condition is not supported.
dcl-proc CondExpr;
  dcl-pi *n varchar(200);
    i_cond varchar(300) const;
  end-pi;

  dcl-s l_i int(10);
  dcl-s l_ch char(1);
  dcl-s l_inQ ind inz(*off);
  dcl-s l_inE ind inz(*off);
  dcl-s l_split int(10) inz(0);
  dcl-s l_left varchar(200);
  dcl-s l_right varchar(200);
  dcl-s l_a varchar(60);
  dcl-s l_b varchar(60);
  dcl-s l_mask varchar(8);
  dcl-s l_u varchar(300);

  l_u = Up(i_cond);
  if %len(l_u) = 9 and %subst(l_u:1:6) = 'SWITCH'
     and %check('12345678':%subst(l_u:7:1)) = 0
     and %subst(l_u:8:1) = '-' and %check('01':%subst(l_u:9:1)) = 0;
    l_mask = 'XXXXXXXX';
    %subst(l_mask:%int(%subst(l_u:7:1)):1) = %subst(l_u:9:1);
    return '%SWITCH(' + l_mask + ')';
  endif;

  for l_i = 1 to %len(i_cond);
    l_ch = %subst(i_cond:l_i:1);
    if l_ch = C_QUOTE;
      l_inQ = not l_inQ;
    elseif l_ch = '?' and not l_inQ;
      l_inE = not l_inE;
    elseif (l_ch = '/' or l_ch = '=') and not l_inQ and not l_inE;
      l_split = l_i;
      leave;
    endif;
  endfor;
  if l_split = 0;
    return '';
  endif;
  if l_split > 1;
    l_left = %subst(i_cond:1:l_split - 1);
  else;
    l_left = '';
  endif;
  if l_split < %len(i_cond);
    l_right = %subst(i_cond:l_split + 1);
  else;
    l_right = '';
  endif;
  l_a = CondOperand(l_left);
  l_b = CondOperand(l_right);
  if l_a = '' or l_b = '';
    return '';
  endif;
  return l_a + ' *EQ ' + l_b;
end-proc;

// ------------------------------------------------------------------
// Takes the leading IF / IFT / IFF / ELSE words off the statement text and
// returns the CL condition they make (empty when there are none). An ELSE
// must be the first word and refers to the IF on the line before it.
// Returns *OFF (with o_why) when a condition cannot be converted.
dcl-proc IfChain;
  dcl-pi *n ind;
    io_s varchar(512);
    o_cond varchar(500);
    o_why varchar(100);
  end-pi;

  dcl-s l_kw varchar(10);
  dcl-s l_p int(10);
  dcl-s l_i int(10);
  dcl-s l_inQ ind;
  dcl-s l_tok varchar(300);
  dcl-s l_e varchar(200);
  dcl-s l_lineLast varchar(500) inz('');
  dcl-s l_elseCond varchar(500) inz('');
  dcl-s l_sawIf ind inz(*off);
  dcl-s l_sawElse ind inz(*off);

  o_cond = '';
  dow *on;
    l_p = %scan(' ':io_s);
    if l_p = 0;
      l_kw = Up(io_s);
    else;
      l_kw = Up(%subst(io_s:1:%min(l_p - 1:10)));
    endif;

    if l_kw = 'ELSE';
      if l_sawIf or l_sawElse or g_ifLast = '';
        o_why = 'ELSE does not directly follow an IF line';
        g_ifLast = '';
        g_ifCtx = '';
        return *off;
      endif;
      if g_ifCtx = '';
        l_elseCond = '*NOT (' + g_ifLast + ')';
      else;
        l_elseCond = '(' + g_ifCtx + ') *AND *NOT (' + g_ifLast + ')';
      endif;
      o_cond = l_elseCond;
      l_sawElse = *on;
      if l_p = 0;
        io_s = '';
      else;
        io_s = %trim(%subst(io_s:l_p + 1));
      endif;

    elseif l_kw = 'IF' or l_kw = 'IFT' or l_kw = 'IFF';
      if l_p = 0;
        o_why = 'IF without a condition';
        g_ifLast = '';
        g_ifCtx = '';
        return *off;
      endif;
      io_s = %trim(%subst(io_s:l_p + 1));
      l_inQ = *off;
      l_i = 1;
      dow l_i <= %len(io_s);
        if %subst(io_s:l_i:1) = C_QUOTE;
          l_inQ = not l_inQ;
        endif;
        if %subst(io_s:l_i:1) = ' ' and not l_inQ;
          leave;
        endif;
        l_i += 1;
      enddo;
      l_tok = %subst(io_s:1:l_i - 1);
      if l_i > %len(io_s);
        io_s = '';
      else;
        io_s = %trim(%subst(io_s:l_i + 1));
      endif;
      l_e = CondExpr(l_tok);
      if l_e = '';
        o_why = 'Condition ' + l_tok + ' is not converted';
        g_ifLast = '';
        g_ifCtx = '';
        return *off;
      endif;
      if l_kw = 'IFF';
        l_e = '*NOT (' + l_e + ')';
      endif;
      if l_lineLast = '';
        l_lineLast = l_e;
      else;
        l_lineLast = '(' + l_lineLast + ') *AND (' + l_e + ')';
      endif;
      if o_cond = '';
        o_cond = l_e;
      else;
        o_cond = '(' + o_cond + ') *AND (' + l_e + ')';
      endif;
      l_sawIf = *on;

    else;
      leave;
    endif;
  enddo;

  if l_sawIf;
    g_ifLast = l_lineLast;
    if l_sawElse;
      g_ifCtx = l_elseCond;
    else;
      g_ifCtx = '';
    endif;
  else;
    g_ifLast = '';
    g_ifCtx = '';
  endif;
  return *on;
end-proc;

// ------------------------------------------------------------------
// Cuts operands at the first blank outside apostrophes: what follows is a
// comment. Returns the comment text.
dcl-proc SplitTail;
  dcl-pi *n varchar(512);
    io_ops varchar(512);
  end-pi;

  dcl-s l_i int(10);
  dcl-s l_inQ ind inz(*off);
  dcl-s l_tail varchar(512);

  for l_i = 1 to %len(io_ops);
    if %subst(io_ops:l_i:1) = C_QUOTE;
      l_inQ = not l_inQ;
    endif;
    if %subst(io_ops:l_i:1) = ' ' and not l_inQ;
      l_tail = %trim(%subst(io_ops:l_i + 1));
      io_ops = %subst(io_ops:1:l_i - 1);
      return l_tail;
    endif;
  endfor;
  return '';
end-proc;

// ------------------------------------------------------------------
// // SWITCH nnnnnnnn   (0 off, 1 on, X unchanged)
dcl-proc DoSwitch;
  dcl-pi *n;
    i_lineNo int(10) const;
    i_text varchar(512) const;
    i_operands varchar(512) const;
  end-pi;

  dcl-s l_s varchar(512);

  l_s = Up(%trim(i_operands));
  if %len(l_s) <> 8 or %check('01X':l_s) > 0;
    ReviewLine(i_lineNo:i_text:'SWITCH needs 8 characters of 0, 1 or X');
    return;
  endif;
  AddBody('CHGJOB SWS(' + l_s + ')');
  RptItem(C_STS_ASSUMPTION:i_lineNo:i_text
          :'S/36 UPSI switches taken as the job switches (CHGJOB SWS)');
end-proc;

// ------------------------------------------------------------------
dcl-proc ProcessStatement;
  dcl-pi *n;
    i_lineNo int(10) const;
    i_text varchar(512) const;
  end-pi;

  dcl-s l_s varchar(512);
  dcl-s l_kw varchar(60);
  dcl-s l_ops varchar(512);
  dcl-s l_p int(10);
  dcl-s l_cmt varchar(512);
  dcl-s l_tail varchar(512);
  dcl-s l_cond varchar(500);
  dcl-s l_why varchar(100);
  dcl-s l_start int(10);
  dcl-s l_i int(10);
  dcl-s l_has ind;

  g_afterRun = *off;
  l_s = %trim(%subst(%trim(i_text):3));
  l_cmt = StripTrailing(l_s);
  if %len(l_s) = 0;
    ReviewLine(i_lineNo:i_text:'Empty OCL statement');
    return;
  endif;

  if not IfChain(l_s:l_cond:l_why);
    ReviewLine(i_lineNo:i_text:l_why);
    return;
  endif;
  if %len(l_s) = 0;
    ReviewLine(i_lineNo:i_text:'IF or ELSE without a statement');
    return;
  endif;
  l_start = g_bodyCnt;

  l_p = %scan(' ':l_s);
  if l_p = 0;
    l_kw = Up(l_s);
    l_ops = '';
  else;
    l_kw = Up(%subst(l_s:1:l_p - 1));
    l_ops = %trim(%subst(l_s:l_p + 1));
  endif;
  if l_kw <> 'EVALUATE' and %len(l_ops) > 0;
    l_tail = SplitTail(l_ops);      // text after the operands is a comment
    if %len(l_tail) > 0;
      if %len(l_cmt) > 0;
        l_cmt = l_tail + ' ' + l_cmt;
      else;
        l_cmt = l_tail;
      endif;
    endif;
  endif;

  select;
    when l_cond <> '' and (l_kw = 'LOAD' or l_kw = 'RUN' or l_kw = 'FILE'
         or l_kw = 'TAG');
      ReviewLine(i_lineNo:i_text
                 :'A conditional ' + l_kw + ' statement is not converted');
    when l_kw = 'LOAD';
      DoLoad(i_lineNo:i_text:l_ops);
    when l_kw = 'RUN';
      DoRun(i_lineNo:i_text:l_ops);
    when l_kw = 'FILE';
      DoFile(i_lineNo:i_text:l_ops);
    when l_kw = 'LOCAL';
      DoLocal(i_lineNo:i_text:l_ops);
    when l_kw = 'EVALUATE';
      DoEvaluate(i_lineNo:i_text:l_ops);
    when l_kw = 'TAG';
      DoTagGoto(i_lineNo:i_text:*on:l_ops);
    when l_kw = 'GOTO';
      DoTagGoto(i_lineNo:i_text:*off:l_ops);
    when l_kw = 'SWITCH';
      DoSwitch(i_lineNo:i_text:l_ops);
    when l_kw = 'RETURN' and %len(l_ops) = 0;
      AddBody('RETURN');
      RptItem(C_STS_CONVERTED:i_lineNo:i_text:'');
    other;
      ReviewLine(i_lineNo:i_text
                 :'OCL statement ' + l_kw + ' is not converted in this version');
  endsl;

  // A condition wraps what the statement wrote into IF ... THEN(DO).
  if l_cond <> '' and g_bodyCnt > l_start;
    l_has = *off;
    for l_i = l_start + 1 to g_bodyCnt;
      if %len(g_body(l_i)) < 2 or %subst(g_body(l_i):1:2) <> '/*';
        l_has = *on;
      endif;
    endfor;
    if l_has and g_bodyCnt + 2 <= C_MAXBODY;
      for l_i = g_bodyCnt downto l_start + 1;
        g_body(l_i + 1) = g_body(l_i);
      endfor;
      g_body(l_start + 1) = 'IF COND(' + l_cond + ') THEN(DO)';
      g_bodyCnt += 1;
      AddBody('ENDDO');
      RptItem(C_STS_ASSUMPTION:i_lineNo:i_text
              :'IF/IFF/ELSE condition compared as text');
    elseif l_has;
      g_overflow = *on;
    endif;
  endif;

  if %len(l_cmt) > 0;
    AddComment(l_cmt);
  endif;
end-proc;

// ------------------------------------------------------------------
// A line without // that starts like a command name is taken as a CL (or
// S/36 environment) command and copied with substitution applied.
dcl-proc PassThrough;
  dcl-pi *n;
    i_lineNo int(10) const;
    i_text varchar(512) const;
  end-pi;

  dcl-s l_p int(10);
  dcl-s l_cmd varchar(60);
  dcl-s l_out varchar(512);
  dcl-s l_open ind;

  l_p = %scan(' ':i_text);
  if l_p = 0;
    l_cmd = Up(i_text);
  else;
    l_cmd = Up(%subst(i_text:1:l_p - 1));
  endif;
  if %len(l_cmd) > 10 or %len(l_cmd) = 0
     or %check('ABCDEFGHIJKLMNOPQRSTUVWXYZ':%subst(l_cmd:1:1)) > 0
     or %check('ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789#@$':l_cmd) > 0;
    ReviewLine(i_lineNo:i_text:'Line is not an OCL statement or a command');
    return;
  endif;

  l_out = Subst(i_text:l_open);
  if l_open;
    ReviewLine(i_lineNo:i_text
               :'Command uses a substitution expression that is not converted');
    return;
  endif;
  AddBody(l_out);
  RptItem(C_STS_ASSUMPTION:i_lineNo:i_text
          :'Copied as a command; check that command ' + l_cmd + ' exists');
end-proc;

// ------------------------------------------------------------------
dcl-proc ProcessLine;
  dcl-pi *n;
    i_lineNo int(10) const;
    i_text varchar(512) const;
  end-pi;

  dcl-s l_t varchar(512);
  dcl-s l_c varchar(512);
  dcl-s l_first2 varchar(2);
  dcl-s l_last2 varchar(2);

  l_t = %trim(i_text);

  if g_sortMode;
    if SortLine(i_lineNo:i_text);
      return;
    endif;
  endif;

  l_first2 = '';
  l_last2 = '';
  if %len(l_t) >= 2;
    l_first2 = %subst(l_t:1:2);
    l_last2 = %subst(l_t:%len(l_t) - 1:2);
  endif;

  select;
    when %len(l_t) = 0;
      AddBody('');
    when %len(l_t) >= 4 and l_first2 = '/*' and l_last2 = '*/';
      // Already a CL comment: keep the text.
      AddCommentRaw(%trimr(%subst(l_t:3:%len(l_t) - 4)));
      RptItem(C_STS_CONVERTED:i_lineNo:i_text:'');
    when %subst(l_t:1:1) = '*';
      // Keep the comment text exactly as written (after the asterisk).
      if %len(l_t) > 1;
        l_c = %trimr(%subst(l_t:2));
      else;
        l_c = '';
      endif;
      if %len(%trim(l_c)) = 0;
        AddBody('');
      else;
        AddCommentRaw(l_c);
      endif;
      RptItem(C_STS_CONVERTED:i_lineNo:i_text:'');
    when l_first2 = '/*' or l_first2 = '/&';
      g_afterRun = *off;
      ReviewLine(i_lineNo:i_text
                 :'End-of-data or end-of-job marker is not converted');
    when l_first2 = '//';
      ProcessStatement(i_lineNo:i_text);
    other;
      PassThrough(i_lineNo:l_t);
  endsl;
end-proc;

// ------------------------------------------------------------------
dcl-proc WriteCl;
  dcl-pi *n int(10);
    i_line varchar(512) const;
    o_msgId char(7);
    o_msgData char(256);
  end-pi;

  dcl-s l_lines int(10);
  dcl-s l_status char(1);

  if WriteText(i_line:C_WRAP_CL:l_lines:l_status:o_msgId:o_msgData) <> 0;
    return 1;
  endif;
  if l_status = C_STS_REVIEW;
    RptItem(C_STS_REVIEW:0:i_line:'Line written without a safe break');
  endif;
  return 0;
end-proc;

// ------------------------------------------------------------------
dcl-proc WriteProgram;
  dcl-pi *n int(10);
    o_msgId char(7);
    o_msgData char(256);
  end-pi;

  dcl-s l_i int(10);
  dcl-s l_line varchar(512);
  dcl-s l_parms varchar(512);

  l_line = 'PGM';
  if g_maxParm > 0;
    l_parms = '';
    for l_i = 1 to g_maxParm;
      if l_i > 1;
        l_parms += ' ';
      endif;
      l_parms += '&P' + %trim(%char(l_i));
    endfor;
    l_line += ' PARM(' + l_parms + ')';
  endif;
  if WriteCl(l_line:o_msgId:o_msgData) <> 0;
    return 1;
  endif;

  for l_i = 1 to g_maxParm;
    if WriteCl('DCL VAR(&P' + %trim(%char(l_i)) + ') TYPE(*CHAR) LEN(10)'
               :o_msgId:o_msgData) <> 0;
      return 1;
    endif;
  endfor;
  // Parameters set by EVALUATE and not passed by the caller are local.
  for l_i = g_maxParm + 1 to 40;
    if g_parKind(l_i) = 'L';
      if WriteCl('DCL VAR(&P' + %trim(%char(l_i)) + ') TYPE(*CHAR) LEN('
                 + %trim(%char(%max(g_parLen(l_i):1))) + ')'
                 :o_msgId:o_msgData) <> 0;
        return 1;
      endif;
    endif;
  endfor;
  for l_i = 1 to g_tmpVar;
    if WriteCl('DCL VAR(&T' + %trim(%char(l_i)) + ') TYPE(*CHAR) LEN(50)'
               :o_msgId:o_msgData) <> 0;
      return 1;
    endif;
  endfor;
  if g_useDate;
    if WriteCl('DCL VAR(&DATE) TYPE(*CHAR) LEN(6)':o_msgId:o_msgData) <> 0;
      return 1;
    endif;
  endif;
  if g_useUser;
    if WriteCl('DCL VAR(&USER) TYPE(*CHAR) LEN(10)':o_msgId:o_msgData) <> 0;
      return 1;
    endif;
  endif;
  if g_useWs;
    if WriteCl('DCL VAR(&WS) TYPE(*CHAR) LEN(10)':o_msgId:o_msgData) <> 0;
      return 1;
    endif;
  endif;
  for l_i = 1 to g_ldaCnt;
    if WriteCl('DCL VAR(&L' + %trim(%char(g_ldaP(l_i))) + '_'
               + %trim(%char(g_ldaN(l_i))) + ') TYPE(*CHAR) LEN('
               + %trim(%char(g_ldaN(l_i))) + ')':o_msgId:o_msgData) <> 0;
      return 1;
    endif;
  endfor;
  if g_useSql;
    if WriteCl('DCL VAR(&SQL) TYPE(*CHAR) LEN(400)':o_msgId:o_msgData) <> 0;
      return 1;
    endif;
  endif;
  if g_useUser;
    if WriteCl('RTVJOBA USER(&USER)':o_msgId:o_msgData) <> 0;
      return 1;
    endif;
  endif;
  if g_useWs;
    if WriteCl('RTVJOBA JOB(&WS)':o_msgId:o_msgData) <> 0;
      return 1;
    endif;
  endif;
  if g_useDate;
    if WriteCl('RTVSYSVAL SYSVAL(QDATE) RTNVAR(&DATE)':o_msgId:o_msgData) <> 0;
      return 1;
    endif;
  endif;

  for l_i = 1 to g_bodyCnt;
    if WriteCl(g_body(l_i):o_msgId:o_msgData) <> 0;
      return 1;
    endif;
  endfor;

  if WriteCl('ENDPGM':o_msgId:o_msgData) <> 0;
    return 1;
  endif;
  return 0;
end-proc;

// ------------------------------------------------------------------
dcl-proc OclConvert export;
  dcl-pi *n int(10);
    i_src likeds(IAcnvDesc_t) const;
    i_tgt likeds(IAcnvDesc_t) const;
    o_msgId char(7);
    o_msgData char(256);
  end-pi;

  dcl-s l_text varchar(512);
  dcl-s l_next varchar(512);
  dcl-s l_t varchar(512);
  dcl-s l_nt varchar(512);
  dcl-s l_no int(10);
  dcl-s l_first int(10);
  dcl-s l_rc int(10);

  g_bodyCnt = 0;
  g_overflow = *off;
  g_maxParm = 0;
  g_parKind(*) = ' ';
  g_parLen(*) = 0;
  g_useDate = *off;
  g_tmpVar = 0;
  g_ldaCnt = 0;
  g_ifLast = '';
  g_ifCtx = '';
  g_useUser = *off;
  g_useWs = *off;
  g_pendLoad = *off;
  g_afterRun = *off;
  g_ovr = '';
  g_sortMode = *off;
  g_sortNo = 0;
  g_sortCnt = 0;
  g_sortIn(*) = '';
  g_sortInLib(*) = '';
  g_sortSrcMbr = '';
  g_sortSrcLib = '';
  g_conditions = *off;
  g_ldaCnt = 0;
  g_blkCnt = 0;
  g_sortOut = '';
  g_sortOutLib = '';
  g_sortExtra = '';
  g_useSql = *off;
  g_isSort = *off;
  g_width = TargetWidthFor(i_tgt);
  if g_width <= 0;
    g_width = C_DFTWIDTH;
  endif;

  if OpenSource(i_src:o_msgId:o_msgData) <> 0;
    return 1;
  endif;

  dow ReadLine(l_text:l_no);
    l_first = l_no;
    l_t = %trim(l_text);

    // A statement continues when it ends with a comma.
    if %len(l_t) >= 2 and %subst(l_t:1:2) = '//';
      dow %len(l_t) > 0 and %subst(l_t:%len(l_t):1) = ',';
        if not ReadLine(l_next:l_no);
          leave;
        endif;
        l_nt = %trim(l_next);
        if %len(l_nt) >= 2 and %subst(l_nt:1:2) = '//';
          l_nt = %trim(%subst(l_nt:3));
        endif;
        l_t += l_nt;
      enddo;
    endif;

    if %len(l_t) >= 2 and %subst(l_t:1:2) = '//';
      ProcessLine(l_first:l_t);
    else;
      ProcessLine(l_first:l_text);   // comments keep their exact text
    endif;
    if g_overflow;
      leave;
    endif;
  enddo;

  if ReadError(o_msgId:o_msgData);
    CloseSource();
    return 1;
  endif;
  CloseSource();

  if g_overflow;
    o_msgId = 'IAC0101';
    o_msgData = 'The program has more than ' + %char(C_MAXBODY)
                + ' converted lines';
    return 1;
  endif;

  if g_sortMode;
    FinishSort();
  endif;
  if g_pendLoad;
    ReviewLine(g_loadLine:g_loadText:'LOAD was never followed by RUN');
    g_pendLoad = *off;
  endif;
  if g_maxParm > 0;
    RptItem(C_STS_ASSUMPTION:0:'Parameters ?n?'
            :'Declared as CHAR(10); check the lengths the callers pass');
  endif;

  if OpenTarget(i_tgt:o_msgId:o_msgData) <> 0;
    return 1;
  endif;
  l_rc = WriteProgram(o_msgId:o_msgData);
  CloseTarget();
  return l_rc;
end-proc;
