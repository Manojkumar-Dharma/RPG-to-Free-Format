**FREE
// IAcnvSrvP - shared constants, structures and prototypes for the
// legacy source converters (IAcnvSrv service program).
// Free-format include; starts with **FREE.
// Include with: /copy IAcnvSrvP
// and compile with INCDIR pointing at the repo's src/common folder.
// Target release V7R3.

/if defined(IACNVSRVP)
/eof
/endif
/define IACNVSRVP

// ---- Constants ------------------------------------------------------
dcl-c C_STMFWIDTH 100;           // max line width for stream-file output
dcl-c C_SRCDTALEN 100;           // data width of a standard source record
dcl-c C_MODE_MBR 'M';            // location mode: source physical file member
dcl-c C_MODE_IFS 'I';            // location mode: IFS stream file

dcl-c C_CNV_OCL 1;               // IAoclToCle
dcl-c C_CNV_DSPF 2;              // IAcnvDspf
dcl-c C_CNV_FREE 3;              // IAcnvFree

dcl-c C_WRAP_NONE 0;             // WriteText: never wrap
dcl-c C_WRAP_CL 1;               // wrap with '+' continuation (CLLE)
dcl-c C_WRAP_FREE 2;             // wrap free-format RPG (comments become //)

dcl-c C_STS_CONVERTED 'C';       // report status: converted
dcl-c C_STS_ASSUMPTION 'A';      // report status: converted with assumption
dcl-c C_STS_REVIEW 'R';          // report status: needs manual review

// ---- Command parameters as received ----------------------------------
// Blank (or *NONE-style empty) values mean "not given".
dcl-ds IAcnvParm_t qualified template;
  srcLib char(10);
  srcFile char(10);
  srcIfs varchar(1024);
  srcMbr char(10);
  srcType char(10);
  srcCcsid int(10);              // -1 means *DFT
  tgtLib char(10);
  tgtFile char(10);
  tgtIfs varchar(1024);
  tgtMbr char(10);
  tgtType char(10);
  tgtCcsid int(10);              // -1 means *DFT
  replace char(4);               // *NO or *YES
end-ds;

// ---- Resolved location (one for source, one for target) ---------------
dcl-ds IAcnvDesc_t qualified template;
  mode char(1);                  // C_MODE_MBR or C_MODE_IFS
  lib char(10);
  file char(10);
  mbr char(10);
  type char(10);                 // validated, upper case
  path varchar(1024);            // full resolved IFS path, IFS mode only
  ccsid int(10);                 // -1 means use the file's own CCSID
  exists ind;                    // the member or stream file exists now
  replaceOk ind;                 // output only: *YES given
end-ds;

// ---- Validation ----------------------------------------------------------
// Returns 0 when valid. Otherwise returns 1 and sets o_msgId / o_msgData
// to the first failure (message ids are defined in the IACNVMSG message file).
dcl-pr ValidateIO int(10);
  i_converter int(10) const;
  i_parm likeds(IAcnvParm_t) const;
  o_src likeds(IAcnvDesc_t);
  o_tgt likeds(IAcnvDesc_t);
  o_msgId char(7);
  o_msgData char(256);
end-pr;

// Source type table helpers
dcl-pr IsValidSrcType ind;
  i_converter int(10) const;
  i_type char(10) const;
end-pr;

dcl-pr IsValidTgtType ind;
  i_converter int(10) const;
  i_type char(10) const;
end-pr;

dcl-pr DefaultTgtType char(10);
  i_converter int(10) const;
end-pr;

// System helpers (module IAcnvSys)
dcl-pr IsSafeName ind;
  i_name char(10) const;
end-pr;

dcl-pr ChkQsysObj ind;
  i_lib char(10) const;
  i_file char(10) const;
  i_mbr char(10) const;
end-pr;

dcl-pr IfsAccess ind;
  i_path varchar(1024) const;
  i_mode int(10) const;
end-pr;

dcl-pr FindIfsName int(10);
  i_dir varchar(1024) const;
  i_name varchar(256) const;
  o_first varchar(256);
  o_list varchar(512);
end-pr;

dcl-pr DirExists ind;
  i_dir varchar(1024) const;
end-pr;

// Source member reader/writer (module IAcnvMbr). One source and one target
// open at a time. Open/write calls return 0, or 1 with o_msgId/o_msgData set.
dcl-pr MbrOpenSource int(10);
  i_desc likeds(IAcnvDesc_t) const;
  o_msgId char(7);
  o_msgData char(256);
end-pr;

dcl-pr MbrReadLine ind;
  o_text varchar(512);
  o_lineNo int(10);
end-pr;

dcl-pr MbrCloseSource;
end-pr;

dcl-pr MbrOpenTarget int(10);
  i_desc likeds(IAcnvDesc_t) const;
  o_width int(10);
  o_msgId char(7);
  o_msgData char(256);
end-pr;

dcl-pr MbrWriteLine int(10);
  i_text varchar(512) const;
  o_msgId char(7);
  o_msgData char(256);
end-pr;

dcl-pr MbrCloseTarget;
end-pr;

dcl-pr MbrTargetWidth int(10);
  i_desc likeds(IAcnvDesc_t) const;
end-pr;

// IFS stream file reader/writer (module IAcnvIfs). Same conventions as above.
// IfsReadLine returns *OFF at end of file or on error: call IfsLastError
// afterwards. It returns *ON (with the message) only for an error.
dcl-pr IfsOpenSource int(10);
  i_desc likeds(IAcnvDesc_t) const;
  o_msgId char(7);
  o_msgData char(256);
end-pr;

dcl-pr IfsReadLine ind;
  o_text varchar(512);
  o_lineNo int(10);
end-pr;

dcl-pr IfsLastError ind;
  o_msgId char(7);
  o_msgData char(256);
end-pr;

dcl-pr IfsCloseSource;
end-pr;

dcl-pr IfsOpenTarget int(10);
  i_desc likeds(IAcnvDesc_t) const;
  o_msgId char(7);
  o_msgData char(256);
end-pr;

dcl-pr IfsWriteLine int(10);
  i_text varchar(512) const;
  o_msgId char(7);
  o_msgData char(256);
end-pr;

dcl-pr IfsCloseTarget;
end-pr;

// Reader/writer for converters (module IAcnvIO). Dispatches by location mode.
dcl-pr OpenSource int(10);
  i_desc likeds(IAcnvDesc_t) const;
  o_msgId char(7);
  o_msgData char(256);
end-pr;

dcl-pr ReadLine ind;
  o_text varchar(512);
  o_lineNo int(10);
end-pr;

// After ReadLine returned *OFF: *ON when it was an error rather than the end.
dcl-pr ReadError ind;
  o_msgId char(7);
  o_msgData char(256);
end-pr;

dcl-pr CloseSource;
end-pr;

dcl-pr OpenTarget int(10);
  i_desc likeds(IAcnvDesc_t) const;
  o_msgId char(7);
  o_msgData char(256);
end-pr;

// Writes one logical line, wrapping at a safe point. o_status is
// C_STS_CONVERTED or C_STS_REVIEW (no safe break available).
dcl-pr WriteText int(10);
  i_text varchar(512) const;
  i_style int(10) const;
  o_lines int(10);
  o_status char(1);
  o_msgId char(7);
  o_msgData char(256);
end-pr;

dcl-pr CloseTarget;
end-pr;

// Width to plan lines for before OpenTarget is called (0 = unknown).
dcl-pr TargetWidthFor int(10);
  i_desc likeds(IAcnvDesc_t) const;
end-pr;

// Conversion report (module IAcnvRpt): plain spooled file IACNVRPT.
dcl-pr RptOpen int(10);
  i_converter int(10) const;
  i_src likeds(IAcnvDesc_t) const;
  i_tgt likeds(IAcnvDesc_t) const;
end-pr;

dcl-pr RptItem;
  i_status char(1) const;
  i_lineNo int(10) const;
  i_text varchar(512) const;
  i_reason varchar(200) const;
end-pr;

dcl-pr RptClose;
  o_conv int(10) options(*nopass);
  o_assump int(10) options(*nopass);
  o_review int(10) options(*nopass);
end-pr;

// Messages to the caller (module IAcnvSys), from message file IACNVMSG.
dcl-pr SendEscape;
  i_msgId char(7) const;
  i_msgData char(256) const;
end-pr;

dcl-pr SendCompletion;
  i_msgId char(7) const;
  i_msgData char(256) const;
end-pr;
