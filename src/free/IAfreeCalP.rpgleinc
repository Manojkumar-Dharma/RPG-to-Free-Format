**FREE
// IAfreeCalP - prototypes between the modules of IACNVFREE: the output
// buffer of IAfreeCvt and the calculation specification converter
// IAfreeCalc.
// Include with: /copy qcpysrc,IAfreeCalP (member IAfreeCalP of file QCPYSRC).
// Target release V7R3.

/if defined(IAFREECALP)
/eof
/endif
/define IAFREECALP

// ---- IAfreeCalc ------------------------------------------------------
dcl-pr CalcStart;
end-pr;

// Looks at every source line before the conversion: the KLIST and KFLD lines
// are collected, so a key list can be used before it is defined.
dcl-pr CalcPrescan;
  i_line char(100) const;
end-pr;

// Looks at every calculation line before the conversion for GOTO, CABxx and TAG
// (RV-14): which jumps are a skip, a jump to the end or a loop is decided at the
// first jump.
dcl-pr CalcJumpScan;
  i_line char(100) const;
  i_lineNo int(10) const;
end-pr;

// The WHENEVER ... GOTO of embedded SQL (RV-37): every source line goes through here
// before the conversion; the executable SQL statements after a WHENEVER get a jump
// event for the planner. Called by CalcJumpScan (RPG II and III) and by IAfreeFx4
// (RPG IV, which makes its own events for the other operations).
dcl-pr CalcSqlJumpScan;
  i_line char(100) const;
  i_lineNo int(10) const;
end-pr;

// The jumps of an RPG IV source (RV-14): IAfreeFx4 gives its GOTO, CABxx, TAG and
// group operations to the planner of IAfreeCalc and asks what to write.
dcl-pr JumpEvent;
  i_lineNo int(10) const;
  i_kind char(1) const;
  i_label varchar(14) const;
  i_condF ind const;
  i_bad ind const;
  i_cond varchar(300) const;
end-pr;

dcl-pr JumpUnsafe;
end-pr;

dcl-pr JumpNegate varchar(310);
  i_cond varchar(300) const;
end-pr;

dcl-pr JumpInfo ind;
  i_lineNo int(10) const;
  o_kind char(1);
  o_act char(1);
  o_label varchar(14);
  o_cond varchar(300);
  o_inSub ind;
  o_loop ind;
  o_loopCond varchar(300);
  o_kEnds int(10);
  o_unconv int(10);
end-pr;

// Defines a field of known length and type (kind C alphanumeric, N numeric with
// the length in digits) for MOVE and MOVEL.
dcl-pr CalcDefineField;
  i_name varchar(10) const;
  i_kind char(1) const;
  i_length int(10) const;
  i_decimals int(10) const;
end-pr;

// An array or table of an E specification (sequence A, D or blank, number of
// entries, name of the alternating array), for LOKUP, MOVEA and the table index.
dcl-pr CalcDefineArray;
  i_name varchar(10) const;
  i_sequence char(1) const;
  i_dim int(10) const;
  i_alt varchar(10) const;
end-pr;

// FREE-60: RPG IV C specifications and the cycle skeleton: the prescan of one line
// (levels, RT) and the call before the conversion of one line.
dcl-pr CalcCycleScan;
  i_line char(100) const;
end-pr;

dcl-pr CalcCycleBefore;
  i_line char(100) const;
  i_lineNo int(10) const;
end-pr;

// *ON when the cycle skeleton (FREE-36) is written for this source: heading, detail
// and total records of the O specifications are written by it (RV-60).
dcl-pr CalcCycleActive ind;
end-pr;

// One C specification line (columns as in the RPG II coding form).
dcl-pr CalcLine;
  i_line char(100) const;
  i_lineNo int(10) const;
end-pr;

// One line of an embedded SQL statement of an SQLRPG source (C/EXEC SQL, C+ and
// C/END-EXEC lines). Returns *on when the line was handled here.
dcl-pr CalcSqlLine ind;
  i_line char(100) const;
  i_lineNo int(10) const;
end-pr;

// Writes the declarations of the result fields and closes the open groups.
dcl-pr CalcFinish;
end-pr;

// ---- IAfreeCvt (output buffer) --------------------------------------
dcl-pr AddOut;
  i_text varchar(200) const;
  i_lineNo int(10) const;
end-pr;

dcl-pr ReviewSpec;
  i_lineNo int(10) const;
  i_line char(100) const;
  i_reason varchar(190) const;
end-pr;

// The renamed fields of an externally described file as assignments (see
// IAfreeCvt FileRenames), '' when there is none.
dcl-pr FileRenames varchar(250);
  i_name varchar(8) const;
end-pr;

// The number of open groups of the RPG IV C specifications (IAfreeFx4), 0 for
// RPG II and III: SQL statements are indented with it (RV-59).
dcl-pr Fx4Depth int(10);
end-pr;

// Opens the group of a skip (the IF that a jump forward became) in the group stack
// of IAfreeFx4: the TAG closes it with ENDIF. Used for the tests of SQLCODE written
// after an SQL statement (RV-37); RPG IV only. Returns *off, and opens nothing, when
// the group stack is full. With i_open *off it only tests for room.
dcl-pr Fx4SkipOpen ind;
  i_open ind const;
end-pr;

// The renamed fields of a file as assignments back to the external fields
// (EXT = NEW), for WRITE and UPDAT; '' when there is none (FREE-25).
dcl-pr FileRenamesBack varchar(250);
  i_name varchar(8) const;
end-pr;

// The externally described file of a record format name (record line of its I
// specifications); '' when the name is not a known record format (FREE-25).
dcl-pr FormatFile varchar(8);
  i_name varchar(8) const;
end-pr;

// A file declared by a converted F specification (see IAfreeCvt FileInfo).
dcl-pr FileInfo ind;
  i_name varchar(8) const;
  o_device char(1);
  o_type char(1);
  o_recDs varchar(12);
  o_keyed ind;
end-pr;

// Record length and usage of a program described DISK file (IAfreeCvt FileOutInfo,
// RV-62): the length, whether the usage has *output, whether it is an update file.
dcl-pr FileOutInfo ind;
  i_name varchar(8) const;
  o_recLen int(10);
  o_output ind;
  o_update ind;
end-pr;

// The primary file of the RPG cycle skeleton (IAfreeCvt CycleInfo): the file, its
// record layout data structure and the number of control fields; *off when the
// cycle skeleton cannot be written (FREE-36). CycleControl gives the field name and
// the control level (1 to 9) of one control field.
dcl-pr CycleInfo ind;
  o_file varchar(8);
  o_recDs varchar(12);
  o_ctlCount int(10);
end-pr;

dcl-pr CycleControl ind;
  i_index int(10) const;
  o_name varchar(6);
  o_level int(10);
end-pr;

// FREE-49: the record types of the primary file (record identifying indicator and
// codes): their number (0 for a plain layout), the test of IA_NEXT and the indicator
// of one type, and the record type of a control field.
dcl-pr CycleTypeCount int(10);
end-pr;

dcl-pr CycleType ind;
  i_index int(10) const;
  o_cond varchar(200);
  o_ind char(2);
end-pr;

dcl-pr CycleControlType int(10);
  i_index int(10) const;
end-pr;

// The WORKSTN file of the source (RV-12): its name, '*MANY' for more than one, ''
// for none. EXFMT and READC name a record format of it.
dcl-pr WorkstnFile varchar(8);
end-pr;

// Adds the DTAARA keyword to a data structure of the I specifications.
dcl-pr CvtDtaaraDs ind;
  i_name varchar(10) const;
  i_external varchar(20) const;
end-pr;

// Whether a data structure of the I specifications has a number of occurrences.
dcl-pr CvtIsOccursDs ind;
  i_name varchar(10) const;
end-pr;

dcl-pr OutCount int(10);
end-pr;

dcl-pr OutSet;
  i_index int(10) const;
  i_text varchar(200) const;
end-pr;

dcl-pr OutInsertAfter;
  i_index int(10) const;
  i_text varchar(200) const;
end-pr;
