**FREE
// IAfreeOutP - prototypes of IAfreeOut, the O specification converter of
// IACNVFREE (FREE-06): exception output (EXCPT) records of a PRINTER file become
// record formats of a printer file DDS source and WRITE statements.
// Include with: /copy qcpysrc,IAfreeOutP (member IAfreeOutP of file QCPYSRC).
// Target release V7R3.

/if defined(IAFREEOUTP)
/eof
/endif
/define IAFREEOUTP

// Resets the state. Called once before the conversion.
dcl-pr OutStart;
end-pr;

// One O specification line of an RPG II or RPG III source (a record line or a
// field, AND or OR line). Returns the number of following lines that belong to
// the same output record and were consumed with it.
dcl-pr OutLine int(10);
  i_index int(10) const;
  i_lineNo int(10) const;
  i_line char(100) const;
end-pr;

// The record formats written by EXCPT with this name (blank = EXCPT without a
// name): their number, the format name and the condition (output indicators)
// of the nth one, '' when it has none.
dcl-pr OutExceptCount int(10);
  i_name varchar(10) const;
end-pr;

dcl-pr OutExceptFormat varchar(10);
  i_name varchar(10) const;
  i_number int(10) const;
end-pr;

dcl-pr OutExceptCond varchar(200);
  i_name varchar(10) const;
  i_number int(10) const;
end-pr;

// RV-62: records of program described DISK files. OutExceptDisk is *on when the
// nth record of the EXCPT name belongs to a DISK file; OutDiskStatements gives its
// statements (the data structure FILE_OUT, %SUBST at the end positions, write or
// delete), 0 with the reason when it cannot be converted.
dcl-pr OutExceptDisk ind;
  i_name varchar(10) const;
  i_number int(10) const;
end-pr;

dcl-pr OutExceptFile varchar(8);
  i_name varchar(10) const;
  i_number int(10) const;
end-pr;

dcl-pr OutDiskStatements int(10);
  i_name varchar(10) const;
  i_number int(10) const;
  o_stmts varchar(250) dim(40);
  o_reason varchar(190);
end-pr;

// The heading, detail (part S) and total (part T) records the cycle skeleton writes
// (RV-60): their number, the format name and the condition of the nth one in source
// order. 1P is IA_FIRST, L1 to L9 and LR are *INL1 to *INL9 and *INLR.
dcl-pr OutCycleCount int(10);
  i_part char(1) const;
end-pr;

dcl-pr OutCycleFormat varchar(10);
  i_part char(1) const;
  i_number int(10) const;
end-pr;

dcl-pr OutCycleCond varchar(200);
  i_part char(1) const;
  i_number int(10) const;
end-pr;

// The statements that clear the fields with blank after (column 39) of the nth
// record, 'clear A; clear B', '' when there is none.
dcl-pr OutExceptAfter varchar(120);
  i_name varchar(10) const;
  i_number int(10) const;
end-pr;

dcl-pr OutCycleAfter varchar(120);
  i_part char(1) const;
  i_number int(10) const;
end-pr;

// Builds the DDS source after the whole source is converted (the field types
// are known then). Returns the number of DDS lines.
dcl-pr OutFinish int(10);
end-pr;

dcl-pr OutDdsLine varchar(80);
  i_index int(10) const;
end-pr;

// The printer file the DDS belongs to ('' when there is no DDS).
dcl-pr OutDdsFile varchar(8);
end-pr;

// RV-62: the printer files that have DDS lines (after OutFinish): their number, the
// name of the nth one, the number of DDS lines of the file with this position among
// all printer files of the source, and the printer file a DDS line (OutDdsLine) is
// of.
dcl-pr OutDdsFileCount int(10);
end-pr;

dcl-pr OutDdsFileName varchar(8);
  i_number int(10) const;
end-pr;

dcl-pr OutDdsLineCount int(10);
  i_number int(10) const;
end-pr;

dcl-pr OutDdsLineFile varchar(8);
  i_index int(10) const;
end-pr;
